# LOCAL AGENT CLIENT ONLY. Keep its private filled copy outside the repository/deployed app.
# Run with node --env-file=/secure/path/client.env --experimental-strip-types scripts/memory-agent.mjs request|read /secure/path/agent-key.json
CHAIN_ID=84532
# Exact hosted /api/mcp endpoint. HTTPS required outside localhost.
MEMORY_MCP_URL=http://localhost:3025/api/mcp
# Owner EVM address and random bytes32 tome ID from the private office/contract.
MEMORY_OWNER=
MEMORY_ID=
# Same verified Base Sepolia MemoryCathedral deployment used by the app.
MEMORY_REGISTRY=
# Narrow purpose sent to Jev. Do not paste private memory or secrets here.
MEMORY_PURPOSE=Personalize one explicitly approved research task.
# Dedicated agent EOA signing key (0x + 64 hex), used ONLY in this local client; no gas/funds needed.
MEMORY_AGENT_PRIVATE_KEY=
# RSA private key is a separate local file created by the keygen command; never upload it to the app.
