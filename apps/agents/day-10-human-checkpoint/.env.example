# Explicit local simulation; independent port 3010.
AGENT_MODE=demo
PUBLIC_ORIGIN=http://localhost:3010
CHAIN_ID=84532
# Real deployment: dedicated World ID production RP/app; fixed action must never change within a campaign.
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_SIGNING_KEY=
WORLD_ACTION=dapptober-human-checkpoint-2026
# Generate a 32+ character random session signing secret; never expose any signing secret in NEXT_PUBLIC variables.
CHECKPOINT_SESSION_SECRET=
# PostgreSQL / Supabase DIRECT connection. Server access only; never expose DB or service-role credentials.
DATABASE_URL=
# Administrative admission pause token; public visitor APIs do not require this token.
OPERATOR_TOKEN=
OWNER_ADDRESS=
RPC_URL=
# Actual ERC-8004 IdentityRegistry on the selected chain (not the Day 03 custom passport).
CHECKPOINT_REGISTRY=
# Deploy HumanCheckpointRewards with fixed reward, campaign and verifier; fund with six-decimal USDC.
CHECKPOINT_REWARDS=
# Dedicated voucher signer; must match rewards.verifier(). Does not send transactions or hold reward funds.
AGENT_PRIVATE_KEY=
USDC_ADDRESS=
TYPESAFE_API_KEY=
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_SMALL_MODEL=gpt-4.1-mini
