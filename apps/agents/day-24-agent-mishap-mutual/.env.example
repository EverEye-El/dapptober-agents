# Umbra Mutual / Day 24. Copy into THIS app's .env.local. Never commit private values.
# demo has synthetic USDC, founding members, roles and claims; real uses the deployed contracts.
AGENT_MODE=demo
CHAIN_ID=84532
PUBLIC_ORIGIN=http://localhost:3024
# Supabase → Connect → Session pooler private PostgreSQL URI. Stores private evidence preimages/reviews/plans.
# Use separate testing/production projects. This is not the public anon key.
SUPABASE_DATABASE_URL=
# Generate a random 32+ character private office/operator token. Enter in the office access screen.
# Protects private evidence and Jev access; it never authorizes a user's wallet transaction.
OPERATOR_TOKEN=
# Dedicated Base Sepolia RPC; replace with a Base mainnet endpoint together with CHAIN_ID=8453 for production.
RPC_URL=https://sepolia.base.org
# Deployed AgentMishapMutual pool and independently verified runtime keccak256 hash (including immutables).
MUTUAL_POOL=
MUTUAL_CODE_HASH=
# Actual matching ERC-8004 Identity/Reputation registry deployments on the selected Base network.
# The reputation registry's getIdentityRegistry() must match. Day 03's local PassportOffice is not this interface.
MUTUAL_IDENTITY_REGISTRY=
MUTUAL_REPUTATION_REGISTRY=
# Canonical Circle USDC. Base production: 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# TypeSafe Jev API key: advisory claim recommendation and evidence sufficiency before UI member ballots.
# Real review sends only explicitly approved redacted evidence. Members, not the model, control payouts.
JEV_API_KEY=
# Optional Snapshot discussion space (e.g. your verified ENS space name), no key needed for low-volume public reads.
# Testnet uses testnet.hub.snapshot.org; Base mainnet uses hub.snapshot.org. Mirror results are advisory.
SNAPSHOT_SPACE=
# Constructor inputs, configured at deployment rather than runtime env:
# Circle USDC, ERC-8004 Identity registry, matching Reputation registry, pause guardian and 1–16 unique trusted reviewers.
# Reviewers' quality-tagged scores are normalized to 0–100. >=3 trusted feedback entries unlock reputation discounts.
# Guardian can pause new underwriting/deposits; cannot withdraw capital, decide claims or block exits/payouts.
# No server private trading key, thirdweb key or OpenAI key required. Members sign their own exact transactions.
