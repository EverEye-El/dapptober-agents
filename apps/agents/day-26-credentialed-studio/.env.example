# Day 26 / TAKE ONE — copy to .env.local. Never commit .env.local.
# Practice: procedural pixels + actual self-signed C2PA; simulated Jev/mint. No paid calls.
AGENT_MODE=demo
# Testing: Base Sepolia 84532. Production: Base 8453, using a separate Supabase project/deployment.
CHAIN_ID=84532
# Exact origin. Set HTTPS hosting origin only at the hosting stage.
PUBLIC_ORIGIN=http://localhost:3026
# Private server bearer token, at least 32 random characters. Enter in studio UI in real mode.
OPERATOR_TOKEN=
# Creator's public EVM wallet. It signs mint transactions in its own wallet; no owner key on server.
OWNER_ADDRESS=
# Dedicated Base Sepolia HTTPS RPC, later Base mainnet RPC. No automatic chain fallback.
RPC_URL=
# Supabase → Connect → Session pooler PostgreSQL URI. Includes private DB password.
# This is NOT the Supabase browser anon key or service-role API key. Same project may serve days; rows are namespaced.
SUPABASE_DATABASE_URL=
# OpenAI project API key with billing and Images API access. No image call in practice mode.
OPENAI_API_KEY=
# Explicit image model; verify account/model access before enabling live generation.
OPENAI_IMAGE_MODEL=gpt-image-1
# TypeSafe System One private API key. Independent metadata provenance gate; fails closed in real mode.
JEV_API_KEY=
# C2PA ES256 leaf certificate followed by its issuer chain, PEM encoded then base64 on ONE line.
# Obtain from a C2PA-capable certificate issuer. Never claim a self-signed test cert is publicly trusted.
C2PA_SIGNING_CERT_PEM_BASE64=
# Matching P-256 private signing key PEM, base64 on ONE line. Private server secret; not an EVM wallet.
C2PA_SIGNING_KEY_PEM_BASE64=
# Reviewed PEM trust-anchor bundle base64, used for independent C2PA signer trust evaluation.
# Do not use arbitrary uploaded certificates as trusted anchors. Local test root is only local test evidence.
C2PA_TRUST_ANCHORS_PEM_BASE64=
# Optional reviewed RFC3161 timestamp service HTTPS URL. Configure issuer policy before production.
C2PA_TIMESTAMP_URL=
# Pinata private JWT with public IPFS file upload scope. Published media/credits are public and persistent.
PINATA_JWT=
# Unified thirdweb private server key (dashboard → API Keys). Used to read NFT drop evidence.
# No NEXT_PUBLIC exposure; no thirdweb browser client key is required by this injected-wallet UI.
THIRDWEB_SECRET_KEY=
# Deploy contracts/src/CredentialedStudio.sol on Base Sepolia, then a separate reviewed Base mainnet drop.
STUDIO_DROP_ADDRESS=
# keccak256 of the verified deployed runtime bytecode, including immutables.
STUDIO_DROP_CODE_HASH=
# Dedicated EVM signing key matching drop.verifier(). Signs 15-minute exact mint permits only.
# No gas balance required. Never use your owner/admin wallet key here.
STUDIO_MINT_SIGNER_PRIVATE_KEY=
