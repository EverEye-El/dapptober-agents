# Day 25 / Vesper Memory Cathedral. Copy to this app's .env.local; never commit private values.
# Demo: real browser encryption, local ciphertext storage, simulated pointers/Jev/agent signatures.
AGENT_MODE=demo
# Test on Base Sepolia 84532; separately deploy Base 8453 for production.
CHAIN_ID=84532
PUBLIC_ORIGIN=http://localhost:3025
# Private office access token, random >=32 characters. Does not decrypt memories or sign wallet actions.
OPERATOR_TOKEN=
# Owner EVM public wallet, 0x + 40 hex; browser signs every pointer/grant/revoke. No owner private key here.
OWNER_ADDRESS=
# Supabase -> Connect -> Session pooler PostgreSQL URI. Server-only, separate test/production project.
SUPABASE_DATABASE_URL=
# Dedicated Base Sepolia RPC; replace with Base RPC together with CHAIN_ID for production.
RPC_URL=https://sepolia.base.org
# Deployed MemoryCathedral contract on the selected chain, 0x + 40 hex.
MEMORY_REGISTRY=
# keccak256 of independently verified deployed runtime bytecode, 0x + 64 hex.
MEMORY_REGISTRY_CODE_HASH=
# Pinata scoped JWT permitting PUBLIC IPFS file upload. Only encrypted envelopes are uploaded.
# Account must support uploads.pinata.cloud/v3/files. Public IPFS can persist after unpin/revocation.
PINATA_JWT=
# TypeSafe/Jev API credential, used for metadata-only access decisions, >=90% confidence for grants/reads.
# No OPENAI_API_KEY is used. Jev never receives memory plaintext or RSA private keys.
JEV_API_KEY=
# Owner RSA and agent RSA private keys belong only in their local clients/backups, NEVER this file.
# Real agents use signed per-call EIP-712 requests over /api/mcp; no server agent signing key exists.
# Lit Protocol is not used: user-held Web Crypto AES-GCM + RSA-OAEP fulfills direct key custody.
