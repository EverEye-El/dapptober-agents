# NERVEFORGE / Day 31. Copy to this app's .env.local; never commit that private file.
AGENT_MODE=demo
CHAIN_ID=84532
PUBLIC_ORIGIN=http://localhost:3031
# Two different random private values, 32+ characters, stable across releases.
# OPERATOR_TOKEN opens the shared live workshop; visitors have separate saved demo workspaces.
OPERATOR_TOKEN=
EXPERIENCE_SESSION_SECRET=
EXPERIENCE_WORKSPACE_ID=foundry-1
# local = one process with a persistent mounted .data directory. Use supabase for serverless.
EXPERIENCE_STORAGE=local
# Supabase → Connect → Session pooler PostgreSQL URI. NOT Supabase API/anon/service-role key.
# May share the platform's Supabase database; NERVEFORGE uses separate namespaced rows.
SUPABASE_DATABASE_URL=
# Real mode: explicitly approve provider processing before true. TypeSafe receives skill IDs,
# policy preset, tool ID and input byte count, never raw tool text. OpenAI receives text only
# for text.brief after caller consent. thirdweb receives the derived executor's account data.
ARCHITECT_PROVIDER_CONSENT=false
# TypeSafe account API key; actual LangChain TypeSafeClassifier gate on every MCP tools/call.
JEV_API_KEY=
# OpenAI Platform billed server key. Used only by text.brief in real mode.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_SMALL_MODEL=gpt-4.1-mini
OPENAI_LARGE_MODEL=gpt-4.1
# thirdweb dashboard private secret. Enable Base Sepolia smart accounts and sponsor-gas billing.
THIRDWEB_SECRET_KEY=
# Generate a NEW random 32-byte hex seed with 0x prefix. Server derives each agent's executor
# key using HMAC(workspace + agent ID). Back up securely; changing it changes future executors.
# This seed is NOT the owner's wallet key. Never expose it with NEXT_PUBLIC_.
ARCHITECT_WALLET_SEED=
# Human owner address only. All deployment/funding instructions are reviewed in their browser wallet.
OWNER_ADDRESS=
RPC_URL=https://sepolia.base.org
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Deploy AgentFoundry(CircleUSDC, official ERC8004 IdentityRegistry). Helper: pnpm deploy:architect.
ARCHITECT_FACTORY=
ARCHITECT_FACTORY_CODE_HASH=
# Official Base Sepolia identity registry is selected in code:
# 0x8004A818BFB912233c491871b3d84c89A494BD9e
# Pin its actual runtime keccak256; review upgradeable implementation too before production.
ARCHITECT_REGISTRY_CODE_HASH=
# Only local chain acceptance uses an override; never override official Base addresses.
ARCHITECT_REGISTRY=
# Official x402 facilitator; verify supports exact eip155:84532 before public paid calls.
# A production provider may need a different HTTPS URL and private Authorization header.
FACILITATOR_URL=https://x402.org/facilitator
FACILITATOR_AUTH_HEADERS_JSON={}
# Production: separate environment/namespace and secrets, CHAIN_ID=8453,
# RPC_URL=<your Base RPC>, USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913,
# official identity=0x8004A169FB4a3325136EB29fA0ceB6D2e539a432, actual deployed factory/pins,
# PUBLIC_ORIGIN=<exact HTTPS origin>, stable Supabase storage. Never copy test funding to Base.
