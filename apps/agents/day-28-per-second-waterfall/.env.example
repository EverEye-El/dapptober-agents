# SPILLWAY / Day 28. Copy to .env.local; never commit private keys or filled local files.
# Demo works without a wallet, protocol deployment or AI key. Each visitor has isolated saved data.
AGENT_MODE=demo
CHAIN_ID=84532
PUBLIC_ORIGIN=http://localhost:3028
# Generate two DIFFERENT private random values (32+ characters). Operator token opens the shared keeper desk.
OPERATOR_TOKEN=
# Signs HttpOnly visitor/keeper cookies. Keep stable across deployments; required in hosted demo too.
WATERFALL_SESSION_SECRET=
WATERFALL_WORKSPACE_ID=spillway-1
# local is for your computer or a host with a persistent mounted disk. For Vercel select supabase.
WATERFALL_STORAGE=local
# Supabase dashboard → Connect → Session pooler → PostgreSQL URI. Private DB URI, NOT anon/service-role API key.
# One Supabase project can serve all days; this package prefixes each workspace in an RLS-enabled table.
SUPABASE_DATABASE_URL=
# simulated makes NO Jev requests. real mode requires live and a TypeSafe key.
WATERFALL_POLICY=simulated
# TypeSafe / Jev API key, server-only. No OpenAI or thirdweb credential is needed by Day 28.
JEV_API_KEY=
JEV_MODEL=jev-latest
# REAL MODE / Base Sepolia testing, then Base mainnet (8453) with separate deployments and funds.
# HTTPS RPC for this exact chain. Owner signs wallet transactions; never put owner private key here.
RPC_URL=https://sepolia.base.org
OWNER_ADDRESS=
# Circle USDC: testnet below. Base mainnet: 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Deploy SpillwayFactory against an independently verified SuperToken wrapping the above Circle USDC.
# Official predeployed test SuperTokens may wrap fake USDC; these are rejected. See README deployment steps.
WATERFALL_FACTORY=
SUPERFLUID_USDCX=
# keccak256 of actual deployed runtime bytecode, including immutables; verified by every live operation.
WATERFALL_FACTORY_CODE_HASH=
SUPERFLUID_USDCX_CODE_HASH=
SUPERFLUID_FORWARDER_CODE_HASH=
# Dedicated gas-only agent EOA, enrolled when a channel is created. It cannot withdraw or change recipient/rate.
WATERFALL_AGENT_ADDRESS=
WATERFALL_AGENT_PRIVATE_KEY=
# LOCAL FIXTURES ONLY (chain 31337). Public Base chains always use official host/forwarder metadata in code.
SUPERFLUID_HOST=
SUPERFLUID_FORWARDER=
