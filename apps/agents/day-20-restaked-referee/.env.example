# Overrule / Day20. Copy to .env.local. No credentials are needed for the sandbox.
AGENT_MODE=demo
CHAIN_ID=84532
PUBLIC_ORIGIN=http://localhost:3020
# Supabase -> Connect -> Session pooler PostgreSQL URI; server-only. Separate testing/production projects.
SUPABASE_DATABASE_URL=
# Generate a unique random >=32-character operator control-room token; never a wallet key.
OPERATOR_TOKEN=
# Private Base Sepolia RPC endpoint. Production uses Base8453; no Ethereum transaction RPC is used by this app.
RPC_URL=
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Deploy contracts/src/RestakedReferee.sol with Circle USDC, approved ERC4626 vault, optional validation registry and review window >=3600seconds.
REFEREE_CONTRACT=
# Independently computed keccak256 deployed runtime bytecode. Pin proxy implementation/trust separately if using a proxy.
REFEREE_CODE_HASH=
# Actual reviewed Base Sepolia ERC4626 vault whose asset() is Circle USDC. Never put a fixture vault in production.
REFEREE_VAULT=
# Deployment block of RestakedReferee, used for bounded event queries. Set before indexing.
REFEREE_START_BLOCK=0
# Optional actual ERC8004 validation registry on selected Base network. Leave blank only if explicitly deploying standalone mode.
REFEREE_VALIDATION_REGISTRY=
# Dedicated Node operator signing key (0x +64hex), server-only; fund with gas and register collateral for THIS wallet.
# It signs/verifies tasks and may submit one verdict transaction per requested task. It cannot withdraw another wallet's bond.
REFEREE_OPERATOR_PRIVATE_KEY=
# TypeSafe dashboard Jev key. Typed slash/release recommendation, >=90% confidence plus deterministic agreement.
JEV_API_KEY=
# OpenAI project key/model access for replay commentary, never slashing authority.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_SMALL_MODEL=gpt-4.1-mini
OPENAI_LARGE_MODEL=gpt-4.1
# Optional EigenLayer v1.9 ECDSA destination certificate inspection on Base/Base Sepolia.
# Set actual official destination verifier address and independently pinned runtime; no invented defaults.
EIGEN_CERTIFICATE_VERIFIER=
EIGEN_VERIFIER_CODE_HASH=
# AVS address/operator-set ID from a genuine source-chain registration and transported operator table.
EIGEN_AVS_ADDRESS=
EIGEN_OPERATOR_SET_ID=
# One >=2/3 stake threshold per configured stake type, basis points. Match transported table dimensions.
EIGEN_STAKE_THRESHOLDS=[6667]
# EigenLayer's Base deployment verifies certificates; source-chain registration/allocation/slashing remains external.
# Base vault-share bonds are distinct from EigenLayer restaked ETH. Do not label standalone bonds EigenLayer-secured.
