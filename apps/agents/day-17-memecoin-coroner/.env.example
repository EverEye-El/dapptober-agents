# TOE TAG / DAY 17 — copy to .env.local. Keep private credentials out of git.
# Demo needs no keys and never silently becomes live evidence.
AGENT_MODE=demo
# Base Sepolia for testing. Mainnet production: 8453, separate Supabase state.
CHAIN_ID=84532
# Dedicated Base Sepolia archive-capable EVM RPC (Alchemy/Infura/etc.).
# Required: pinned-block storage/code/ERC20 reads; no signing permission needed.
RPC_URL=
# Public attester wallet controlled by browser; fund only gas. No server private key.
OWNER_ADDRESS=
# Generate >=32 random characters; enter in private laboratory access screen.
OPERATOR_TOKEN=
# Supabase -> Connect -> Session pooler PostgreSQL URI. Not anon/service_role API key.
SUPABASE_DATABASE_URL=
# Blockscout instance for this chain. Production Base: https://base.blockscout.com
# Only trusted administrator-configured HTTPS origin; token addresses never select hosts.
BLOCKSCOUT_API_URL=https://base-sepolia.blockscout.com
# Optional Blockscout API plan key if your instance requires authentication.
BLOCKSCOUT_API_KEY=
# Deploy contracts/src/CoronerProbe.sol with your reviewed Uniswap V2-compatible router.
# All probe calls revert, undoing every buy/approval/sell. Never sends a real trade from app.
CORONER_PROBE=
# Exact router bound in that probe. Supports V2 token/WETH pools only.
# Do not copy mainnet routers into testnet or substitute Aerodrome/V3 interfaces.
CORONER_ROUTER=
# Optional audited OpenZeppelin VestingWallet LP lockers: [{"address":"...","codeHash":"0x..."}].
# Pin runtime bytecode after reviewing implementation/schedule; interfaces alone are not proof.
# Empty means no external time-lock claim. Burn-address LP is still measured separately.
CORONER_LOCKERS_JSON=[]
# Diagnostic native ETH amount, capped by code at 0.01 ETH. Tenderly only overrides ETH balance.
CORONER_PROBE_ETH=0.001
# Tenderly dashboard Access Token; Account slug; Project slug (three distinct fields).
# Used to simulate the diagnostic probe at the exact snapshot block; no token balance overrides.
TENDERLY_ACCESS_KEY=
TENDERLY_ACCOUNT_SLUG=
TENDERLY_PROJECT_SLUG=
# TypeSafe dashboard Jev API key: typed risk pattern/severity probabilities, not narrative.
JEV_API_KEY=
# OpenAI project API key with billing/model access: writes evidence-linked report text.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_SMALL_MODEL=gpt-4.1-mini
OPENAI_LARGE_MODEL=gpt-4.1
# Pinata JWT with public file upload permission. Used ONLY after public publication consent.
PINATA_JWT=
# Official EAS and SchemaRegistry predeploys on Base Sepolia and Base; verify before use.
EAS_ADDRESS=0x4200000000000000000000000000000000000021
CORONER_SCHEMA_REGISTRY=0x4200000000000000000000000000000000000020
# Register the exact revocable, resolver-free schema from this app README on this chain.
# Enter its bytes32 UID here. Earlier days' schemas have different layouts and cannot be reused.
CORONER_SCHEMA=
# Snapshot maximum age in seconds; same TTL becomes EAS expiration. Default one hour.
CORONER_MAX_REPORT_AGE=3600
# Exact browser origin. Set final HTTPS origin during hosting phase, no trailing slash.
PUBLIC_ORIGIN=http://localhost:3017
