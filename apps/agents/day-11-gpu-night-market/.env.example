# Copy to this app's private .env.local. App reads its own file, not the root.
# Demo runs labelled simulations. Switch to real only after deployment/configuration below.
AGENT_MODE=demo
# Base Sepolia testing; Base production is 8453 with matching RPC/token/market.
CHAIN_ID=84532
RPC_URL=https://sepolia.base.org
# Local Day 11 URL; use your exact HTTPS origin when hosted.
PUBLIC_ORIGIN=http://localhost:3011
# Supabase → Connect → Session pooler: full private database URI with database password.
# Same testing project can serve other days; production must use a separate project.
SUPABASE_DATABASE_URL=
# Generate 32+ random characters; bearer token for the control room and automated bidding API.
OPERATOR_TOKEN=
# Public owner wallet address (0x + 40 hex). Deploy market with this owner.
OWNER_ADDRESS=
# Dedicated compute buyer signer (0x + 64 hex). Fund with testing USDC/ETH, never use owner key.
# Owner must authorize this address's caps and provider allowlist in the deployed market.
AGENT_PRIVATE_KEY=
# TypeSafe/Jev API key with jev-latest access: accepts/rejects bids based on constraints and reliability.
JEV_API_KEY=
# No OpenAI key required: inference is executed by the selected provider's Ollama GPU worker.
# Deploy GpuNightMarket(owner,USDC) and copy the actual contract address here.
GPU_MARKET=
# Circle USDC on Base Sepolia; Base production is 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913.
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Maximum job cost / gross daily reservations in USDC. Owner authorization must match these caps.
GPU_AGENT_JOB_CAP=2
GPU_AGENT_DAILY_CAP=10
# Private reviewed provider bindings (maximum 16). Empty until workers are actually deployed.
# JSON array: address = provider wallet, name = stall label, url = HTTPS worker origin,
# token = same GPU_WORKER_BEARER_TOKEN as worker, websocket = optional public WSS /status URL.
# Format: [{"address":"<provider wallet>","name":"Copper Lantern","url":"<HTTPS worker origin>","token":"<private worker token>","websocket":"<WSS status URL>"}]
# Provider wallet lists its model, VRAM, slots and price onchain. Owner separately allows agent bids.
GPU_PROVIDERS=[]
