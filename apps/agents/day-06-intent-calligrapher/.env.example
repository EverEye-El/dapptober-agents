# Explicit local simulation; switch to real only after completing deployment configuration.
AGENT_MODE=demo
# Testing: Base Sepolia. Production: Base (8453).
# CoW has no Base Sepolia endpoint; demo works, live settlement is blocked explicitly.
CHAIN_ID=84532
PUBLIC_ORIGIN=http://localhost:3006
# Real-mode durable store. One independent deployment / operator per app.
# Supabase Connect: database URI, not project URL/anon/service-role API key.
# Direct, session and transaction pooling supported; use private table-owner connection.
DATABASE_URL=
OPERATOR_TOKEN=
OWNER_ADDRESS=
RPC_URL=
# Dedicated, narrowly funded agent signer; never an owner/admin key.
AGENT_PRIVATE_KEY=
TYPESAFE_API_KEY=
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_SMALL_MODEL=gpt-4.1-mini
AI_LARGE_MODEL=gpt-4.1
COW_CHAIN_ID=84532
# Configure the exact USDC and WETH addresses used by the selected CoW deployment.
COW_USDC=
COW_WETH=
