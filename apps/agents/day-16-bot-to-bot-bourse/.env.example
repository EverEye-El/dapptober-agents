# BRASS / DAY 16 — copy to .env.local; never commit .env.local.
# Demo is fully usable without keys. Real mode never falls back to simulation.
AGENT_MODE=demo
# Testing: Base Sepolia 84532. Production: Base 8453 with separate Supabase workspace.
CHAIN_ID=84532
# Dedicated Base Sepolia RPC (Alchemy, Infura, or another EVM RPC provider).
RPC_URL=
# Circle USDC on Base Sepolia. Mainnet: 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Buyer agent's EVM wallet, controlled by your browser wallet. No buyer private key on server.
OWNER_ADDRESS=
# ERC-8004 identity token ID whose getAgentWallet equals OWNER_ADDRESS.
BOURSE_BUYER_ID=
# Deployed official ERC-8004 Identity Registry on this chain. Verify its ABI/bytecode first.
BOURSE_REGISTRY=
# Your deployed contracts/src/BotBourse.sol USDC escrow. Constructor cap cannot be raised.
BOURSE_ESCROW=
# App order ceiling, in USDC (also constrained by immutable onchain maxDeal).
BOURSE_MAX_USDC=25
# Reviewed seller catalog JSON. See README for schema. No fabricated real counterparties.
# Each includes id,name,skill,description,wallet,agentId,floor,ask,minutes,local.
# Local seller: local=true plus private token of >=32 random characters.
# Remote seller: local=false plus exact HTTPS cardUrl, endpoint and optional private token.
# Credentials here are server-only. Public cards/API omit token and signing keys.
BOURSE_SELLERS_JSON=[]
# Local sellers only: map seller id -> EVM private key matching its ERC-8004 agentWallet.
# These keys sign bounded offers/output hashes; never control buyer money. Keep them gasless.
BOURSE_SELLER_KEYS_JSON={}
# Supabase -> Connect -> Session pooler PostgreSQL URI. NOT anon/service_role key.
# One shared project can store daily namespaces; use separate test and production projects.
SUPABASE_DATABASE_URL=
# Generate at least 32 random characters; enter this in private floor access screen.
OPERATOR_TOKEN=
# TypeSafe dashboard key for Jev typed accept/counter/reject and delivery safety gate.
JEV_API_KEY=
# OpenAI project API key (billing enabled), used by local real sellers to fulfill text jobs.
# Not used for demo. Remote sellers manage their own model credentials.
OPENAI_API_KEY=
# OpenAI-compatible chat provider endpoint and model IDs (server-only).
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_SMALL_MODEL=gpt-4.1-mini
OPENAI_LARGE_MODEL=gpt-4.1
# Exact browser origin. Change to final HTTPS origin at hosting step, no trailing slash.
PUBLIC_ORIGIN=http://localhost:3016
