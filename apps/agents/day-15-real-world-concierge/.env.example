# Day 15 Aurel — copy this file to .env.local. All values stay server-only.
# Sandbox provides fictional funds and deterministic, explicitly simulated eligibility/yield/settlement.
AGENT_MODE=demo
# Base Sepolia for testing; switch to Base 8453 only with separate reviewed catalog and database.
CHAIN_ID=84532
RPC_URL=https://sepolia.base.org
# Native Circle USDC on Base Sepolia. Base mainnet: 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913.
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Public INVESTOR wallet address. This wallet signs EVERY approval/request/claim/redemption.
# No AGENT_PRIVATE_KEY or server spending key is used by this day.
OWNER_ADDRESS=
# Unique random 32+ character deployment operator secret; protects private investor state and AI API.
OPERATOR_TOKEN=
# Supabase Dashboard > Connect > Session pooler PostgreSQL connection URI, NOT an anon/publishable key.
# Separate testing and production databases; least-privilege DB role and backups are required for release.
SUPABASE_DATABASE_URL=
# Reviewed JSON array of Centrifuge AsyncVault dossiers; see config/catalog.base.example.json.
# The example uses verified BASE MAINNET addresses and is NOT usable on Base Sepolia.
# For testnet obtain an issuer-approved Base Sepolia vault/share pair and testnet membership.
# Bind issuer facts to sources, current eligibility countries, minimum and a future reviewUntil date.
# Empty array deliberately blocks real subscriptions; never copy demo funds into production.
RWA_CATALOG_JSON=[]
# Chainlink USDC / USD aggregator PROXY on this exact Base network, from the official feed directory.
# Public address, not an API key. Real reads verify description, round validity, positive value,
# freshness and a 0.95–1.05 USD band. No unverified testnet address is supplied.
CHAINLINK_USDC_USD_FEED_ADDRESS=
# Feed-specific reviewed heartbeat (seconds). Adjust to the chosen official feed's published heartbeat.
CHAINLINK_USDC_MAX_AGE_SECONDS=86400
# Optional on Base Sepolia (no official testnet sequencer feed is assumed).
# Base MAINNET defaults to official proxy 0xBCF85224fc0756B9Fa45aA7892530B47e10b6433,
# and always enforces sequencer up + a 3600-second post-recovery grace period.
CHAINLINK_SEQUENCER_FEED_ADDRESS=
# Maximum accepted age of Centrifuge priceLastUpdated, in seconds. Verify issuer valuation cadence.
RWA_NAV_MAX_AGE_SECONDS=172800
# Per-preview app allocation limit. Investor remains the only signer; no autonomous spending authority.
RWA_MAX_ALLOCATION_USDC=1000
# TypeSafe Jev server key: typed eligibility gate, uncertainty and small/large reasoning route.
JEV_API_KEY=
# OpenAI billing/model-enabled server API key: cited dossier explanations through Vercel AI SDK.
# Jev runs BEFORE this model; missing/rejected providers never silently fall back to simulation.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_SMALL_MODEL=gpt-4.1-mini
OPENAI_LARGE_MODEL=gpt-4.1
# Set the exact final HTTPS origin only after local/provider rehearsal.
PUBLIC_ORIGIN=http://localhost:3015
