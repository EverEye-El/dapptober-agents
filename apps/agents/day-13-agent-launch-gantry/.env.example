# Day 13 / Gantry.fun — copy this file to .env.local. Never commit .env.local.
# Demo: deterministic simulation, no funds, no live AI calls. Change to real only after setup.
AGENT_MODE=demo
# Testing: Base Sepolia 84532. Production: Base 8453, separate Supabase project and deployments.
CHAIN_ID=84532
RPC_URL=https://sepolia.base.org
# Circle USDC on Base Sepolia. Base mainnet: 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913.
USDC_ADDRESS=0x036CbD53842c5426634e7929541ec2318f3dCF7e
# Public creator/operator wallet address (0x + 40 hex). Never enter a private key here.
OWNER_ADDRESS=
# Generate a random 32+ character operator secret; authorizes launch analysis and autonomous buys.
# It is not a wallet key. Enter it in this app's operator access screen.
OPERATOR_TOKEN=
# Supabase Dashboard > Connect > Session pooler PostgreSQL URI. Server only; NOT anon/publishable key.
# Same testing Supabase project can be shared across daily apps; namespace includes day/operator.
SUPABASE_DATABASE_URL=
# Verified AgentLaunchGantry factory address from deployment receipt on the chosen Base chain.
LAUNCH_FACTORY=
# GantryBuyerVault deployment address; constructor: owner, buyer signer, Circle USDC, factory.
# Owner-signed grants enforce listing allowlist, caps, UTC-day spent, expiry and pause onchain.
LAUNCH_BUYER_VAULT=
# Dedicated bounded buyer wallet private key (0x + 64 hex). Fund this signer with gas only; fund the buyer vault with capped USDC.
# Server signs ONLY explicitly allowed curve buys, subject to daily/per-buy caps and pause.
AGENT_PRIVATE_KEY=
# USDC cap per agent buy and UTC-day cap. Stored spent survives stopping/rearming the buyer.
LAUNCH_AGENT_BUY_CAP=5
LAUNCH_AGENT_DAILY_CAP=20
# TypeSafe Jev server access: launch risk gate, listing risk indicators and paid-service gate.
JEV_API_KEY=
# OpenAI server key with billing/model access: listing narration and launched agents' text services.
# A failed paid inference can be retried; no automatic contract refund.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_SMALL_MODEL=gpt-4.1-mini
OPENAI_LARGE_MODEL=gpt-4.1
# thirdweb Dashboard > project > API keys > secret key. Server-only fixed token supply verification.
# Solidity tokens inherit pinned thirdweb ERC20Base; no dashboard token deployment is required.
THIRDWEB_SECRET_KEY=
# Dune Settings > API key. Read-only latest query result; do not enter a dashboard URL.
DUNE_API_KEY=
# Numeric saved Dune query ID. Publish/refresh the supplied docs/DAY-13-DUNE.sql on Base mainnet.
# Required columns: chain_id, factory, agent, revenue_usdc, trade_usdc. Results must be <24h old.
# Base Sepolia may not be indexed by Dune: use authoritative RPC totals during testing.
DUNE_LAUNCH_QUERY_ID=
# Local development origin. After wallet/provider rehearsal, replace with exact hosted HTTPS origin.
PUBLIC_ORIGIN=http://localhost:3013
