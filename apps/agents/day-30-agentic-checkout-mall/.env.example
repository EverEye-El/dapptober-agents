# AFTERHOURS / Day 30. Private local config; keep keys server-only.
AGENT_MODE=demo
CHAIN_ID=84532
PUBLIC_ORIGIN=http://localhost:3030
# DIFFERENT random stable secrets, 32+ characters. Operator opens shared merchant/shopper workspace.
OPERATOR_TOKEN=
EXPERIENCE_SESSION_SECRET=
EXPERIENCE_WORKSPACE_ID=afterhours-1
# Vercel/serverless: supabase. local requires one process and a persistent mounted .data volume.
EXPERIENCE_STORAGE=local
# Supabase → Connect → Session pooler private PostgreSQL URI, NOT API key.
SUPABASE_DATABASE_URL=
# Real mode only. Explicitly approve sharing shopping preferences, budgets, allowed sellers and
# public catalog metadata with TypeSafe/Jev and OpenAI before setting true. No delivery address/card data is collected.
MALL_PROVIDER_CONSENT=false
# TypeSafe Jev typed budget/allowlist gate and model routing. Server only.
JEV_API_KEY=
# OpenAI platform billed key for explanations/planning. Demo makes no provider calls.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_SMALL_MODEL=gpt-4.1-mini
OPENAI_LARGE_MODEL=gpt-4.1
# Buyer wallet; its private key stays in the browser wallet. Use separate merchant/arbiter wallets.
OWNER_ADDRESS=
MALL_MERCHANT_ADDRESS=
# Independent dispute arbiter; used by the deployment helper, then read from the immutable contract.
MALL_ARBITER_ADDRESS=
RPC_URL=https://sepolia.base.org
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Deploy AfterhoursCheckout(CircleUSDC, quoteSignerPublicAddress, independentArbiter).
MALL_CHECKOUT=
MALL_CHECKOUT_CODE_HASH=
# Server-only merchant quote EOA key; signs fixed buyer/item/seller/amount/expiry. Needs no funds.
MALL_QUOTE_SIGNING_PRIVATE_KEY=
# Public thirdweb dashboard client ID, domain-restricted. Connect/TransactionButton payment UI only.
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=
