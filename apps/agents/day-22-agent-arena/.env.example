# Day 22 / Pitlane. Copy to THIS app's .env.local. Never commit private values.
AGENT_MODE=demo
# Test on Base Sepolia. Switch to Base 8453 only after public-chain acceptance and release review.
CHAIN_ID=84532
PUBLIC_ORIGIN=http://localhost:3022
# Supabase → Connect → Session pooler PostgreSQL URI (server-only; not the public anon key).
SUPABASE_DATABASE_URL=
# Random >=32 character private operator token. Only operator automation/admin uses this.
# Spectators/trainers authenticate public actions with their EOA wallet signature and a one-use nonce.
OPERATOR_TOKEN=
# Dedicated Base Sepolia RPC from your infrastructure provider; never expose private RPC keys in browser.
RPC_URL=https://sepolia.base.org
# AgentArena deployment and independently verified runtime keccak256 hash.
ARENA_CONTRACT=
ARENA_CODE_HASH=
# Circle USDC on Base Sepolia. Production Base: 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913.
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Private GAS-ONLY pilot keys, keyed by registered fighter ID. Each must match its frozen onchain pilot.
# Example shape: {"1":"YOUR_0x_PRIVATE_KEY","2":"ANOTHER_0x_PRIVATE_KEY"}. Leave {} for demo.
# Keys can only exercise the pilot's game authority; never fund pilots with wager USDC.
ARENA_PILOT_KEYS_JSON={}
# ETH gas budgets per pilot per UTC day. Signed outbox reserves worst-case cost before broadcast.
ARENA_MAX_GAS_GWEI=1
ARENA_GAS_DAILY_ETH=0.005
# TypeSafe Jev API key: legality/fairness gate before each commit and reveal; fail closed if uncertain.
JEV_API_KEY=
# OpenAI project API key: training coach only. Billing/model access must be enabled.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_SMALL_MODEL=gpt-4.1-mini
OPENAI_LARGE_MODEL=gpt-4.1
# Deployment constructor inputs below are OPERATOR NOTES, not runtime env names:
# house treasury, pause guardian, Chainlink VRF coordinator, lane key hash, subscription ID.
# Base Sepolia coordinator (verify official docs at deployment):
# 0x5C210eF41CD1a72de73bF76eC39637bB0d3d7BEE
# Lane: 0x9e1344a1247c8a1785d0a4681a27152bffdb43666ae5bf7d14d24a5efd44bf71
# Create/fund a VRF v2.5 subscription with LINK and enroll AgentArena as its consumer.
# Subscription ID is a constructor argument; no Chainlink API key is required.
