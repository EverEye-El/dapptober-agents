# Day 14 — copy to .env.local. Every key is server-only; never commit the private file.
# Demo runs complete simulated policies/approvals/alerts/shutdown with no money or external inference.
AGENT_MODE=demo
# Testing on Base Sepolia; production on Base 8453 with separate database/contracts.
CHAIN_ID=84532
RPC_URL=https://sepolia.base.org
USDC_ADDRESS=0x036CbD53842c5426634e7929541ec2318f3dCF7e
# Production Circle USDC: 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913.
# Human owner wallet address. Owner signatures change policies/recover funds/cosign escalated payments.
OWNER_ADDRESS=
# Generate a random 32+ character operator secret; protects API/MCP and private approvals/receipts.
OPERATOR_TOKEN=
# Supabase Dashboard > Connect > Session pooler PostgreSQL URI (not publishable/anon key).
# Real mode locks the day/operator workspace transactionally for permits and receipts.
SUPABASE_DATABASE_URL=
# GuardrailSentinel deployment address from verified receipt; constructor: owner, guardian, Circle USDC.
SENTINEL_VAULT=
# Separate guardian private key (0x + 64 hex), distinct from owner and all session keys.
# Jev control-plane signer: binds every payment permit, can revoke the fleet, cannot recover funds/resume.
# Fund with native gas for automatic critical shutdown. Keep it separate from session-key custody.
SENTINEL_GUARDIAN_PRIVATE_KEY=
# Private JSON signer catalog, e.g. objects containing name and privateKey (no dummy keys shipped).
# Names label the roster; derived addresses must match owner-enrolled onchain session policies.
# These keys need native gas only. Fund each agent's contract compartment with USDC through the UI.
SENTINEL_SIGNERS=[]
# TypeSafe Jev server key. Passed explicitly to official @langchain/typesafe TypeSafeClassifier.
# No additional TYPESAFE_API_KEY alias is needed. Missing/malformed inference blocks tools.
JEV_API_KEY=
# OpenAI server key with billing/model access; used only for guardian chat explanations.
# Jev chooses small/large model; chat has no wallet tools or spending authority.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_SMALL_MODEL=gpt-4.1-mini
OPENAI_LARGE_MODEL=gpt-4.1
# Tenderly Dashboard > Settings > Authorization > access key for the Simulation API.
# Every real Base payment requires both RPC simulation and successful Tenderly simulation.
TENDERLY_ACCESS_KEY=
# Exact Tenderly account slug and project slug from its dashboard URL (not a wallet address).
TENDERLY_ACCOUNT_SLUG=
TENDERLY_PROJECT_SLUG=
# After local/provider rehearsal, set exact final HTTPS origin for auth and MCP origin/host protection.
PUBLIC_ORIGIN=http://localhost:3014
