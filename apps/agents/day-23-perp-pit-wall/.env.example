# REDLINE / Day 23. Copy this to THIS app's .env.local. Keep private values out of Git.
# demo: synthetic positions, orders and coaching; no exchange orders or paid calls.
AGENT_MODE=demo
PUBLIC_ORIGIN=http://localhost:3023
# Shared project network preference. Day 23's venue API is Hyperliquid native, NOT a Base contract.
CHAIN_ID=84532
# Hyperliquid testnet for venue testing; mainnet only after independent funded acceptance.
# No API key required for public account/market reads. Native exchange orders use your browser wallet.
HYPERLIQUID_NETWORK=testnet
# Your MASTER Hyperliquid account EVM address (0x + 40 hex), not a delegated agent address.
# It is pinned per private deployment. Never enter its private key in any environment file.
HYPERLIQUID_ACCOUNT_ADDRESS=
# Hard app preview ceiling in USD notional, $10–$1000; default $250. Venue reduceOnly also enforced.
PIT_MAX_ORDER_USD=250
# Supabase → Connect → Session pooler PostgreSQL connection URI, private server value.
# Use a separate project for testing vs production; stores pending order IDs and audit history.
SUPABASE_DATABASE_URL=
# Generate a random 32+ character operator access token; enter it in this app's private access screen.
# Protects account snapshots, AI calls and plans; it does not authorize any wallet transaction.
OPERATOR_TOKEN=
# TypeSafe Jev API key: alert-priority/band escalation, confidence gates and model routing.
JEV_API_KEY=
# OpenAI project API key with model access/billing, used only for trader radio and debriefs.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_SMALL_MODEL=gpt-4.1-mini
OPENAI_LARGE_MODEL=gpt-4.1
# No thirdweb key, RPC_URL, smart-contract deployment, exchange API secret or server trading key required.
# Fund/enable an account on the selected Hyperliquid venue separately; no bridge or deposit is automated.
