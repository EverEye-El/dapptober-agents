# Default is a deterministic simulation. No real USDC or oracle settlement.
AGENT_MODE=demo
PUBLIC_ORIGIN=http://localhost:3009
# Testing: Base Sepolia (84532). Production: Base (8453); replace RPC/token/contract addresses.
CHAIN_ID=84532
# Live: independently verify UMA's official network registry, oracle currency whitelist
# and minimum bond on the selected chain. Testnets do not provide production DVM evidence.
RPC_URL=
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
FORECAST_MARKET=
UMA_ORACLE=
OWNER_ADDRESS=
# Server agent wallet; fund narrowly with USDC and gas. Register onchain risk caps first.
AGENT_PRIVATE_KEY=
OPERATOR_TOKEN=
# Supabase Connect: database URI, not project URL/anon/service-role API key.
# Direct, session and transaction pooling supported; use private table-owner connection.
DATABASE_URL=
TYPESAFE_API_KEY=
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_SMALL_MODEL=gpt-4.1-mini
AI_LARGE_MODEL=gpt-4.1
# Deploy ForecastColosseum(owner,USDC,OOv3,7200,bytes32("ASSERT_TRUTH2")).
# Use >=2 hour liveness for live use; 120 seconds is only a local test setting.
# Exact stablecoin bonds are discovered using OOv3.getMinimumBond(USDC).
