# DEADLOCK — Day 27. Copy to .env.local locally; use your host's private environment for deployment.
# Demo mode is a supported launch mode: simulated ghosts/prizes, real saved edits and visitor progress.
AGENT_MODE=demo
CHAIN_ID=84532
PUBLIC_ORIGIN=http://localhost:3027

# Storage: dev may use local files. For Vercel/serverless, set SUPABASE_DATABASE_URL.
# Supabase → Connect → Session pooler → PostgreSQL URI. Server-only, NEVER the anon/public API key.
# Use separate Supabase projects for testing and production. No database credentials are supplied.
SUPABASE_DATABASE_URL=
# Keep local for development or a single server with a mounted persistent .data disk.
# On serverless use supabase; a missing connection then fails visibly instead of losing content.
HAUNTED_STORAGE=local
# Stable namespace for this mansion's shared room catalog. Keep stable across redeploys.
HAUNTED_WORKSPACE_ID=deadlock-season-1
# Generate a random secret of at least 32 characters. Signs visitor cookies; changing loses visit access.
HAUNTED_SESSION_SECRET=
# Generate another random secret of at least 32 characters. Enter at Keeper's desk to add/remove rooms or pause.
# Not a wallet key. Never expose as NEXT_PUBLIC_* or put into a public URL.
OPERATOR_TOKEN=

# Optional real dialogue while keeping demo prizes. Default uses deterministic ghost personas, no paid API.
HAUNTED_DIALOGUE=simulated
# TypeSafe Jev API key from its console. Checks move types before LLM dialogue.
JEV_API_KEY=
JEV_MODEL=jev-latest
# OpenAI platform API key with billing enabled, used only when HAUNTED_DIALOGUE=live.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_SMALL_MODEL=gpt-4.1-mini
OPENAI_LARGE_MODEL=gpt-4.1

# Optional real contract mode below. Demo deployment does not need these, gas, or USDC.
# Set AGENT_MODE=real only after deployment and bounded funded acceptance.
# thirdweb dashboard → project → public client ID, with your hosted domain allowed. No thirdweb secret key needed.
THIRDWEB_CLIENT_ID=
# Your server's Base Sepolia RPC; use Base RPC and CHAIN_ID=8453 for a separately funded production season.
RPC_URL=https://sepolia.base.org
# Circle USDC on Base Sepolia. Base mainnet: 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913.
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Deployed HauntedContract address and keccak256 of exact runtime bytecode (including immutables).
HAUNTED_CONTRACT=
HAUNTED_CODE_HASH=
# There is NO server player/deployer private key. Browser wallets sign every onchain move.
