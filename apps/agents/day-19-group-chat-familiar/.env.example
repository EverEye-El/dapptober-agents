# Gremlin / Day 19. Copy to .env.local; secrets stay server-side.
AGENT_MODE=demo
CHAIN_ID=84532
PUBLIC_ORIGIN=http://localhost:3019
# Supabase -> Connect -> Session pooler PostgreSQL URI. Public bot-command/action rooms only.
SUPABASE_DATABASE_URL=
# Unique >=32-character backend state namespace/operator token. Never give it to group members.
OPERATOR_TOKEN=
# >=32-character random HMAC secret for five-minute request-bound wallet challenges.
FAMILIAR_SESSION_SECRET=
# Private Base Sepolia RPC. Browser wallet provides its own chain connection.
RPC_URL=
# Deploy GroupChatFamiliar on Base Sepolia; mainnet later uses Base8453 + its Circle USDC.
FAMILIAR_CONTRACT=
# Independently checked keccak256 deployed runtime bytecode.
FAMILIAR_CODE_HASH=
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# TypeSafe dashboard Jev API key; classifies mentions and chooses small/creative model.
JEV_API_KEY=
# OpenAI project API key/model access, used for chat and user-requested meme captions only.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_SMALL_MODEL=gpt-4.1-mini
OPENAI_LARGE_MODEL=gpt-4.1
# Public, operator-reviewed nickname->wallet address book. Real mode can fall back to Neynar verified addresses.
FAMILIAR_MEMBERS_JSON=[]
# Neynar dashboard API key for username->verified Ethereum wallet lookup, server-only. No cast-posting signer needed.
NEYNAR_API_KEY=
# Farcaster developer manifest tool's signed accountAssociation JSON for the exact final HTTPS domain.
FARCASTER_ACCOUNT_ASSOCIATION={}
# thirdweb dashboard PUBLIC client ID, domain restricted; optional mainnet BuyWidget top-up only.
THIRDWEB_CLIENT_ID=
# Native commands are disabled unless conversations are explicitly enrolled below.
# All accepted /gremlin excerpts and action cards are PUBLIC at the room URL. Obtain group consent before enrollment.
# Entries: {"platform":"telegram|discord|slack","channel":"actual channel/chat id","workspace":"guild/team id when applicable","room":"degen-lounge"}
FAMILIAR_CHAT_ROOMS_JSON=[]
# BotFather bot token. Set webhook to /api/telegram with this independent >=32-char secret_token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Discord developer application Ed25519 PUBLIC key (64 hex) for /api/discord verification.
DISCORD_PUBLIC_KEY=
# Discord bot token with Send Messages in enrolled channels; slash /gremlin string option "command".
DISCORD_BOT_TOKEN=
# Slack app Basic Information signing secret; slash /gremlin request URL /api/slack.
SLACK_SIGNING_SECRET=
# Slack xoxb bot token with chat:write in enrolled channels. Values entered privately; no token examples committed.
SLACK_BOT_TOKEN=
# No agent private key: each user signs every token approval and chain action in a wallet.
