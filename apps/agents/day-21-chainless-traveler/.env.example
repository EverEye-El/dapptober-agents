# Day 21 / Layover. Copy this file to this app's .env.local; never commit .env.local.
# Start in demo. Switch to real only after configuring and checking every dependency below.
AGENT_MODE=demo
# Base Sepolia testing = 84532. Production = Base 8453, separate Supabase project and addresses.
CHAIN_ID=84532
PUBLIC_ORIGIN=http://localhost:3021
# Supabase → Connect → Session pooler PostgreSQL connection URI. Server only, not an anon/API key.
SUPABASE_DATABASE_URL=
# Random >=32-character private operator login for this deployment. Generate with openssl rand -hex 32.
OPERATOR_TOKEN=
# thirdweb dashboard → project → API keys. Client ID is public; restrict it to your exact app domains.
THIRDWEB_CLIENT_ID=
# Same thirdweb project secret key, server only. Used to request Bridge quotes/status.
THIRDWEB_SECRET_KEY=
# thirdweb dashboard → Account Abstraction → sponsored gas. Enable Base Sepolia first, set policy and billing caps.
# Gas comes from this project's paymaster. Browser owner signs every call; no AGENT_PRIVATE_KEY is used.
# Funding accounts JSON. Add Base destination first; test setup permits ONLY chainId 84532.
# Fields: chainId, name, rpc (private RPC URL), usdc (Circle USDC), bundler (thirdweb bundler JSON-RPC URL),
# entryPoint (deployed ERC-4337 EntryPoint matching smartWallet version). Obtain exact URLs and address from thirdweb.
# Example shape only; replace all placeholders before real mode:
# [{"chainId":84532,"name":"Base Sepolia","rpc":"https://rpc.invalid","usdc":"0x036CbD53842c5426634e7929541eC2318f3dCF7e","bundler":"https://bundler.invalid","entryPoint":"REVIEWED_ENTRYPOINT_ADDRESS"}]
# Production may additionally include 1/10/42161 with their own RPC, canonical USDC, bundler and EntryPoint.
# Wallet connection derives a separate smart account on each source. Fund those addresses, not the EOA.
TRAVEL_SOURCES_JSON=[]
# Reviewed route router AND allowance spender runtime pins from the provider's official deployments.
# Shape [{"provider":"thirdweb" or "lifi","chainId":84532,"address":"...","codeHash":"0x..."}]
# Empty = no external bridge/swap router approved. Direct Base USDC payments still work with a configured source.
# Pin router implementations/facets separately in operational review; a proxy bytecode hash alone cannot pin upgrades.
TRAVEL_ROUTERS_JSON=[]
# Optional LI.FI Partner Portal API key; production swap quota. REST endpoints are fixed in code.
LIFI_API_KEY=
LIFI_INTEGRATOR=dapptober-layover
# Deploy contracts/src/LayoverPass.sol on Base Sepolia with Circle USDC and your treasury recipient.
# Fixed price = 1 USDC; runtime hash from verified deployed code. Mint path remains unavailable until set.
TRAVEL_PASS=
TRAVEL_PASS_CODE_HASH=
# TypeSafe Jev dashboard API key. Typed approved-route choice and small/large explanation model routing.
JEV_API_KEY=
# OpenAI project API key for itinerary explanations, billing enabled. No AI is called in demo.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_SMALL_MODEL=gpt-4.1-mini
OPENAI_LARGE_MODEL=gpt-4.1
