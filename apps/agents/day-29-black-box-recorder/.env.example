# MAYDAY / Day 29. Copy to .env.local. Never commit a filled local file.
AGENT_MODE=demo
CHAIN_ID=84532
PUBLIC_ORIGIN=http://localhost:3029
# Private 32+ random characters; opens shared operator flight and authenticates OTLP producers.
OPERATOR_TOKEN=
# DIFFERENT private stable 32+ random characters; signs isolated visitor/keeper cookies.
EXPERIENCE_SESSION_SECRET=
EXPERIENCE_WORKSPACE_ID=mayday-1
# local = one app process on persistent disk. Vercel/serverless must use supabase.
EXPERIENCE_STORAGE=local
# Supabase → Connect → Session pooler → private PostgreSQL URI, not anon/service-role API key.
SUPABASE_DATABASE_URL=
# Real mode only: TypeSafe / Jev billed API key. No OpenAI or thirdweb key is needed.
JEV_API_KEY=
# EXPLICIT DATA-SHARING OPT-IN. Default false sends no recorder data to TypeSafe/Jev.
# Set true only after approving transmission of redacted step fields and batch integrity/flag-count
# summaries to https://api.typesafe.ai/v1/systemone. Never include secrets/personal data in logs.
RECORDER_JEV_METADATA_CONSENT=false
# Stable private EOA signing key (0x + 64 hex). No funds needed; back it up securely.
# Demo creates a per-workspace signing key server-side; it is never returned to visitors.
RECORDER_SIGNING_PRIVATE_KEY=
# Wallet that signs EAS anchors. Keep its private key in your wallet, not this app.
OWNER_ADDRESS=
RPC_URL=https://sepolia.base.org
# Official Base Sepolia and Base EAS address. Pin actual reviewed runtime bytecode keccak256.
RECORDER_EAS=0x4200000000000000000000000000000000000021
RECORDER_EAS_CODE_HASH=
# Register a nonrevocable schema on the chain’s SchemaRegistry with resolver zero:
# bytes32 workspace,bytes32 root,uint256 first,uint256 last,bytes32 head,address signer
RECORDER_SCHEMA=
