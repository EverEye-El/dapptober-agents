# This app reads its own .env.local. Leave demo until actual deployment, keys and funds are ready.
AGENT_MODE=demo
# Fixed project network: Base Sepolia testing; production is Base 8453 with matching addresses.
CHAIN_ID=84532
RPC_URL=https://sepolia.base.org
PUBLIC_ORIGIN=http://localhost:3012
# Supabase → Connect → Session pooler: full private database connection URI, not a Supabase API key.
SUPABASE_DATABASE_URL=
# Generate a unique 32+ random-character token for this app's control room and agent API.
OPERATOR_TOKEN=
# Owner public wallet (0x + 40 hex); controls agent caps, work approval and pause.
OWNER_ADDRESS=
# Dedicated AI-license buyer signer (0x + 64 hex), narrowly funded USDC/ETH, never your owner key.
AGENT_PRIVATE_KEY=
# TypeSafe/Jev key for approved-template selection and purchase admission. No OpenAI key needed.
JEV_API_KEY=
# Pinata API JWT permitted to upload public files. Registration publishes text/metadata only after consent.
PINATA_JWT=
# thirdweb project server secret for certificate owner verification. Never use the public client ID here.
THIRDWEB_SECRET_KEY=
# Deploy ProvenancePress(owner,USDC) on Base Sepolia and paste the actual address.
# Custom Base registry: NOT Story Protocol/PIL; SDK 1.4.4 supports Story/Aeneid, not Base.
PROVENANCE_PRESS=
# Decimal block number from the registry deployment receipt, used for paginated public royalty history.
PRESS_START_BLOCK=
# Circle Base Sepolia USDC. Base production is 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913.
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Maximum fee per agent license and gross daily purchases, in USDC. Set matching owner-approved contract caps.
PRESS_AGENT_LICENSE_CAP=2
PRESS_AGENT_DAILY_CAP=10
