# Runnable offline. Demo ECDSA key is PUBLIC and confers no hardware trust.
AGENT_MODE=demo
PUBLIC_ORIGIN=http://localhost:3007
# Real mode: deployment-specific bearer token (32+ random characters), durable storage, Jev.
OPERATOR_TOKEN=
# Supabase Connect: database URI, not project URL/anon/service-role API key.
# Direct, session and transaction pooling supported; use private table-owner connection.
DATABASE_URL=
TYPESAFE_API_KEY=
# HTTPS ingress to the worker running entirely inside a dstack Intel TDX CVM.
TEE_WORKER_URL=
TEE_WORKER_TOKEN=
TEE_MODEL=qwen3:0.6b
# Exact Ollama model manifest SHA256, prefixed 0x (64 lowercase hex characters).
TEE_MODEL_DIGEST=
# JSON with mrtd, rtmr0, rtmr1, rtmr2, rtmr3; each is 96 lowercase hex characters.
# Enroll only measurements independently derived from your reviewed immutable deployment.
TEE_MEASUREMENTS={}
# Optional owner-wallet publication: Base Sepolia testing, Base production. No server private key needed.
# Testing: Base Sepolia (84532). Production: Base (8453); replace RPC/token/contract addresses.
CHAIN_ID=84532
RPC_URL=
INFERENCE_ANCHOR=
OWNER_ADDRESS=
