# Hush / Day 18. Copy to .env.local. Never commit private configuration.
# Demo: browser-only AES simulation, no FHE network, no money or chain transactions.
AGENT_MODE=demo
# Testing stays on Base Sepolia. Base mainnet 8453 remains blocked until CoFHE support is verified.
CHAIN_ID=84532
PUBLIC_ORIGIN=http://localhost:3018
# Supabase -> Connect -> Session pooler PostgreSQL URI. Private; not an anon/service-role API key.
# Separate test and production Supabase projects. Only amount-free metadata/receipts are stored.
SUPABASE_DATABASE_URL=
# Unique >=32-character operator bearer secret for this app's amount-free service.
OPERATOR_TOKEN=
# Optional public lab owner address; this does not grant decryption of bidders' balances.
OWNER_ADDRESS=
# Private Base Sepolia RPC for validating receipts. Never sent to the browser.
RPC_URL=
# Browser-visible Base Sepolia RPC. Any key embedded here is public; use a domain-restricted key.
CONFIDANT_PUBLIC_RPC_URL=https://sepolia.base.org
# Your deployed EncryptedConfidant contract on Base Sepolia.
CONFIDANT_CONTRACT=
# keccak256 deployed runtime bytecode, independently checked after deployment.
CONFIDANT_CODE_HASH=
# TypeSafe dashboard API key. Receives only one of sealed-bid / hidden-order / payroll.
JEV_API_KEY=
# OpenAI project API key with billing/model access. Receives public protocol category only.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_SMALL_MODEL=gpt-4.1-mini
OPENAI_LARGE_MODEL=gpt-4.1
# CoFHE uses official SDK Base Sepolia endpoints. No invented CoFHE API key or server wallet needed.
# Wallet signs each transaction and a contract-scoped, short-lived decryption ACP in the browser.
# Fund only Base Sepolia ETH for gas. Allocation credits are NOT USDC or token deposits.
