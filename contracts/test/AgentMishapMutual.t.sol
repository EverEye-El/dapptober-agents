pragma solidity ^0.8.24;
import 'forge-std/Test.sol';import '@openzeppelin/contracts/token/ERC20/ERC20.sol';import '../src/AgentMishapMutual.sol';
contract MutualUSDC is ERC20 {constructor()ERC20('USDC','USDC'){}function decimals()public pure override returns(uint8){return 6;}function mint(address a,uint256 n)external{_mint(a,n);}}
contract MutualIdentity {address public owner;constructor(address a){owner=a;}function ownerOf(uint256)external view returns(address){return owner;}function getAgentWallet(uint256)external view returns(address){return owner;}function transfer(address a)external{owner=a;}}
contract MutualReputation {address public identity;uint64 public count=5;int128 public score=80;uint8 public decimals;bool public fail;constructor(address a){identity=a;}function getIdentityRegistry()external view returns(address){return identity;}function getSummary(uint256,address[] calldata,string calldata,string calldata)external view returns(uint64,int128,uint8){require(!fail,'offline');return(count,score,decimals);}function set(uint64 c,int128 s,uint8 d)external{count=c;score=s;decimals=d;}function setFail()external{fail=true;}}
contract AgentMishapMutualTest is Test {
 MutualUSDC token;MutualIdentity identity;MutualReputation rep;AgentMishapMutual m;address member=address(11);address second=address(12);address owner=address(13);address guardian=address(14);
 function setUp()public{token=new MutualUSDC();identity=new MutualIdentity(owner);rep=new MutualReputation(address(identity));address[] memory reviewers=new address[](1);reviewers[0]=address(20);m=new AgentMishapMutual(address(token),address(identity),address(rep),guardian,reviewers);for(uint i;i<3;i++){address a=i==0?member:i==1?second:owner;token.mint(a,2000e6);vm.prank(a);token.approve(address(m),type(uint256).max);}vm.prank(member);m.deposit(1000e6,1000e6);vm.prank(second);m.deposit(1000e6,1000e6);vm.roll(block.number+1);}
 function buy()internal returns(uint id){vm.prank(owner);return m.buy(1,100e6,10e6);}
 function file(uint policy)internal returns(uint id){vm.warp(block.timestamp+1 hours+1);vm.prank(owner);return m.file(policy,80e6,block.timestamp,keccak256('incident'),keccak256('logs'),'ipfs://evidence');}
 function approve(uint id)internal{vm.prank(member);m.vote(id,true);vm.warp(block.timestamp+3 days);m.settle(id);}
 function testPremiumYieldAndLossAccounting()public{uint policy=buy();assertEq(m.assets(),2003600000);uint claim=file(policy);approve(claim);assertEq(m.reserved(),0);assertEq(m.credits(owner),80e6);assertEq(m.assets(),1923600000);vm.prank(owner);m.claimPayout();assertEq(token.balanceOf(owner),2076400000);vm.prank(member);m.withdraw(1000e6,961800000);assertEq(token.balanceOf(member),1961800000);}
 function testReputationAndClaimsChangeRate()public{(uint premium,uint score,uint rate)=m.quote(1,100e6);assertEq(score,80);assertEq(rate,360);assertEq(premium,3600000);uint claim=file(buy());approve(claim);(premium,,rate)=m.quote(1,100e6);assertEq(rate,460);assertEq(premium,4600000);}
 function testUntrustedSparseAndDecimals()public{rep.set(2,100,0);(uint premium,uint score,)=m.quote(1,100e6);assertEq(score,0);assertEq(premium,10e6);rep.set(4,9800,2);(,score,)=m.quote(1,100e6);assertEq(score,98);rep.set(4,-10,0);(,score,)=m.quote(1,100e6);assertEq(score,0);}
 function testCapitalCannotExitWhileBackingPolicy()public{uint id=buy();vm.prank(member);vm.expectRevert('capital backs cover');m.withdraw(1,0);vm.warp(block.timestamp+10 days+1);m.expire(id);vm.prank(member);m.withdraw(1000e6,1000e6);}
 function testLateCapitalCannotVoteAndClaimantCannotVote()public{uint claim=file(buy());address late=address(90);token.mint(late,20e6);vm.startPrank(late);token.approve(address(m),20e6);m.deposit(20e6,0);vm.expectRevert('snapshot member');m.vote(claim,true);vm.stopPrank();vm.prank(owner);vm.expectRevert('ballot');m.vote(claim,true);}
 function testSameBlockCapitalAndPurchaseRejected()public{vm.prank(member);m.deposit(10e6,0);vm.prank(owner);vm.expectRevert('capital block');m.buy(1,100e6,10e6);}
 function testDuplicateBallotAndIncident()public{uint claim=file(buy());vm.prank(member);m.vote(claim,true);vm.prank(member);vm.expectRevert('ballot');m.vote(claim,false);vm.prank(owner);vm.expectRevert('policy');m.file(1,1,block.timestamp,keccak256('incident'),keccak256('x'),'ipfs://x');}
 function testTieAndNoQuorumDeny()public{uint id=file(buy());vm.prank(member);m.vote(id,true);vm.prank(second);m.vote(id,false);vm.warp(block.timestamp+3 days);m.settle(id);assertEq(m.credits(owner),0);assertEq(m.reserved(),0);}
 function testNoVotesCannotPay()public{uint id=file(buy());vm.warp(block.timestamp+3 days);m.settle(id);assertEq(m.credits(owner),0);}
 function testWaitingPeriodAndOversizedClaim()public{uint id=buy();vm.prank(owner);vm.expectRevert('incident window');m.file(id,1,block.timestamp,keccak256('i'),keccak256('e'),'ipfs://e');vm.warp(block.timestamp+3601);vm.prank(owner);vm.expectRevert('evidence/amount');m.file(id,101e6,block.timestamp,keccak256('i'),keccak256('e'),'ipfs://e');}
 function testPauseCannotBlockVotingSettlementOrPayout()public{uint id=file(buy());vm.prank(guardian);m.setPaused(true);approve(id);vm.prank(owner);m.claimPayout();assertEq(m.creditsTotal(),0);vm.prank(member);m.withdraw(10e6,0);}
 function testOwnerTransferDoesNotRedirectExistingBeneficiary()public{uint id=buy();identity.transfer(address(99));uint claim=file(id);approve(claim);assertEq(m.credits(owner),80e6);assertEq(m.credits(address(99)),0);}
 function testBudgetAndQuoteSlippage()public{vm.prank(owner);vm.expectRevert('price/capital');m.buy(1,100e6,1);rep.setFail();vm.expectRevert('offline');m.quote(1,100e6);}
 function testNoGuardianDrainAndClosedSeason()public{vm.prank(owner);vm.expectRevert('guardian');m.setPaused(true);vm.warp(block.timestamp+7 days);vm.prank(owner);vm.expectRevert('underwriting closed');m.buy(1,100e6,10e6);}
 function testFuzzConservation(uint64 raw)public{uint amount=bound(raw,1,100e6);uint policy=buy();vm.warp(block.timestamp+3601);vm.prank(owner);uint claim=m.file(policy,amount,block.timestamp,keccak256('incident'),keccak256('evidence'),'ipfs://e');approve(claim);assertEq(m.assets()+m.creditsTotal(),token.balanceOf(address(m)));assertLe(m.reserved(),m.assets());}
 function testDeniedIncidentDoesNotBurnFutureLegitimateClaim()public{uint first=buy();uint other=buy();uint denied=file(first);vm.warp(block.timestamp+3 days);m.settle(denied);assertFalse(m.incidents(keccak256('incident')));vm.prank(owner);uint retry=m.file(other,20e6,block.timestamp,keccak256('incident'),keccak256('new evidence'),'ipfs://review');approve(retry);assertEq(m.credits(owner),20e6);}
 function testParallelIncidentCanOnlyPayOnce()public{uint first=buy();uint other=buy();uint claim=file(first);vm.prank(owner);uint duplicate=m.file(other,20e6,block.timestamp,keccak256('incident'),keccak256('more evidence'),'ipfs://parallel');vm.prank(member);m.vote(claim,true);vm.prank(member);m.vote(duplicate,true);vm.warp(block.timestamp+3 days);m.settle(claim);m.settle(duplicate);assertEq(m.credits(owner),80e6);assertEq(m.reserved(),0);assertTrue(m.incidents(keccak256('incident')));}

}
