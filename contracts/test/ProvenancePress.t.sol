pragma solidity ^0.8.24;
import {ProvenancePress} from "../src/ProvenancePress.sol";
import {MockUSDC,Vm} from "./Agents.t.sol";
contract ProvenancePressTest {
 Vm vm=Vm(address(uint160(uint256(keccak256("hevm cheat code")))));MockUSDC token;ProvenancePress press;address alice=address(0x1234);address bob=address(0x2345);address buyer=address(0x3456);address agent=address(0x4567);
 function setUp() public {token=new MockUSDC();press=new ProvenancePress(address(this),address(token));token.mint(buyer,100e6);token.mint(bob,100e6);token.mint(agent,100e6);vm.prank(buyer);token.approve(address(press),type(uint256).max);vm.prank(bob);token.approve(address(press),type(uint256).max);vm.prank(agent);token.approve(address(press),type(uint256).max);}
 function original(uint8 terms) internal returns(uint256 id){vm.prank(alice);return press.register("Copper Atlas","ipfs://fixture",keccak256(abi.encode(terms)),terms,1e6,0);}
 function testRegisterAndImmutableCertificate() public {uint256 id=original(0);require(press.ownerOf(id)==alice,"owner wrong");vm.prank(alice);vm.expectRevert(bytes("certificate immutable"));press.transferFrom(alice,bob,id);vm.prank(alice);vm.expectRevert(bytes("invalid work"));press.register("Duplicate","ipfs://fixture",keccak256(abi.encode(uint8(0))),0,1e6,0);vm.expectRevert(bytes("unapproved terms"));press.templateHash(3);}
 function testFreeHumanAndPaidTraining() public {uint256 id=original(0);vm.prank(buyer);press.buy(id,0,0);require(token.balanceOf(address(press))==0,"human charged");vm.prank(buyer);press.buy(id,1,1e6);require(press.credit(alice)==1e6,"credit wrong");vm.prank(alice);press.claim();require(token.balanceOf(alice)==1e6,"claim wrong");vm.prank(alice);vm.expectRevert(bytes("no royalties"));press.claim();}
 function testPurposeRestrictionsAndPreviewFee() public {uint256 id=original(1);vm.prank(buyer);vm.expectRevert(bytes("purpose forbidden"));press.buy(id,1,1e6);vm.prank(buyer);press.buy(id,2,1e6);vm.prank(buyer);vm.expectRevert(bytes("purpose forbidden"));press.buy(id,3,1e6);vm.prank(buyer);vm.expectRevert(bytes("fee exceeds preview"));press.buy(id,2,999999);id=original(2);vm.prank(buyer);vm.expectRevert(bytes("purpose forbidden"));press.buy(id,2,1e6);}
 function testDerivativePermissionAndInheritedTerms() public {uint256 id=original(0);vm.prank(bob);vm.expectRevert(bytes("remix permission"));press.register("Remix","ipfs://fixture",keccak256("remix"),0,1e6,id);vm.prank(bob);press.buy(id,3,1e6);vm.prank(bob);vm.expectRevert(bytes("inherited terms"));press.register("Remix","ipfs://fixture",keccak256("remix"),1,1e6,id);vm.prank(bob);vm.expectRevert(bytes("inherited terms"));press.register("Remix","ipfs://fixture",keccak256("remix"),0,999999,id);}
 function testDerivativeRoyaltyConservationAndClaims() public {uint256 id=original(0);vm.prank(bob);press.buy(id,3,1e6);vm.prank(bob);uint256 child=press.register("Remix","ipfs://fixture",keccak256("remix"),0,1e6,id);vm.prank(buyer);press.buy(child,1,1e6);require(press.credit(alice)==1200000&&press.credit(bob)==800000,"split wrong");vm.prank(alice);press.claim();vm.prank(bob);press.claim();require(token.balanceOf(address(press))==0,"unclaimed residue");require(press.claimed(alice)+press.claimed(bob)==2e6,"conservation");}
 function testAgentCapsAllowlistExpiryAndRenewal() public {uint256 id=original(0);press.setAgent(agent,1e6,1e6,block.timestamp+1 days,false);vm.prank(agent);vm.expectRevert(bytes("agent stopped or work not approved"));press.buy(id,1,1e6);press.allowWork(id,true);vm.prank(agent);vm.expectRevert(bytes("agent human-use forbidden"));press.buy(id,0,0);vm.prank(agent);press.buy(id,1,1e6);press.setAgent(agent,1e6,1e6,block.timestamp+2 days,false);vm.prank(agent);vm.expectRevert(bytes("agent budget"));press.buy(id,1,1e6);press.setAgent(agent,1e6,1e6,block.timestamp,true);vm.prank(agent);vm.expectRevert(bytes("agent stopped or work not approved"));press.buy(id,1,1e6);}
 function testPauseRetainsClaimAndOwnerControl() public {uint256 id=original(0);vm.prank(buyer);press.buy(id,2,1e6);vm.prank(buyer);vm.expectRevert(bytes("owner only"));press.setPaused(true);press.setPaused(true);vm.prank(buyer);vm.expectRevert(bytes("press paused"));press.buy(id,2,1e6);vm.prank(alice);press.claim();require(token.balanceOf(alice)==1e6,"pause trapped funds");}
 function testFuzzRoyaltyRoundingConserves(uint32 raw) public {uint256 fee=uint256(raw)%10e6+1;vm.prank(alice);uint256 id=press.register("Original","ipfs://fixture",keccak256("original"),0,fee,0);vm.prank(bob);press.buy(id,3,fee);vm.prank(bob);uint256 child=press.register("Child","ipfs://fixture",keccak256("child"),0,fee,id);vm.prank(buyer);press.buy(child,1,fee);require(press.credit(alice)+press.credit(bob)==2*fee,"rounding loss");}
}
