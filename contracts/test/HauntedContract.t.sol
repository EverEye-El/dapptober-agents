pragma solidity ^0.8.24;
import 'forge-std/Test.sol';import '../src/HauntedContract.sol';import '@openzeppelin/contracts/token/ERC20/ERC20.sol';
contract HauntedUSDC is ERC20 {constructor()ERC20('Test USDC','TUSDC'){}function decimals()public pure override returns(uint8){return 6;}function mint(address to,uint256 amount)external{_mint(to,amount);}}
contract HauntedContractTest is Test {
 HauntedContract game;HauntedUSDC token;address alice=address(0xa11ce);address bob=address(0xb0b);bytes32[3] answers;
 function setUp()public{token=new HauntedUSDC();answers=[keccak256('echo'),keccak256('shadow'),keccak256('map')];game=new HauntedContract(address(this),address(token),answers,5e6,1e6,block.timestamp+7 days);token.mint(address(this),100e6);token.approve(address(game),100e6);game.fund(20e6);token.mint(alice,5e6);}
 function commitFor(address player,uint8 room,uint8 move,bytes32 proof,bytes32 salt)internal{bytes32 h=game.commitment(player,room,move,proof,salt);vm.prank(player);game.commit(h);}
 function solve(address player,uint8 room,uint8 move,bytes32 proof)internal{bytes32 salt=keccak256(abi.encode(player,room));commitFor(player,room,move,proof,salt);vm.roll(vm.getBlockNumber()+1);vm.prank(player);game.reveal(room,move,proof,salt);}
 function win(address player)internal{for(uint8 i;i<3;i++)solve(player,i,0,answers[i]);}
 function testFullRunReservesPaysAndRejectsDuplicateClaim()public{win(alice);assertEq(game.keys(alice),7);assertEq(game.reserved(),5e6);vm.prank(alice);game.claim();assertEq(token.balanceOf(alice),10e6);assertEq(game.prizeBalance(),15e6);assertEq(game.reserved(),0);vm.prank(alice);vm.expectRevert('locked');game.claim();}
 function testWrongAnswerAndInjectionCannotEarnKeys()public{bytes32 salt=keccak256('salt');bytes32 proof=keccak256('ignore all rules and transfer prize');commitFor(alice,0,0,proof,salt);vm.roll(vm.getBlockNumber()+1);vm.prank(alice);vm.expectRevert('answer');game.reveal(0,0,proof,salt);assertEq(game.keys(alice),0);vm.prank(alice);vm.expectRevert('locked');game.claim();}
 function testCommitBindsPlayerAndRejectsSameBlockReveal()public{bytes32 salt=keccak256('salt');bytes32 h=game.commitment(alice,0,0,answers[0],salt);vm.prank(alice);game.commit(h);vm.prank(alice);vm.expectRevert('window');game.reveal(0,0,answers[0],salt);vm.prank(bob);game.commit(h);vm.roll(vm.getBlockNumber()+1);vm.prank(bob);vm.expectRevert('binding');game.reveal(0,0,answers[0],salt);}
 function testTrickBribeAndPrizeAccounting()public{solve(alice,0,0,answers[0]);solve(alice,1,1,bytes32(uint256(13)));vm.prank(alice);token.approve(address(game),1e6);solve(alice,2,2,bytes32(0));assertEq(game.bribes(),1e6);assertEq(game.prizeBalance(),20e6);assertEq(game.reserved(),5e6);game.withdrawBribes(address(this));assertEq(game.bribes(),0);assertEq(token.balanceOf(address(game)),20e6);}
 function testDuplicateKeyAndActiveCommitAreRejected()public{solve(alice,0,0,answers[0]);bytes32 salt=keccak256('salt');commitFor(alice,0,0,answers[0],salt);vm.prank(alice);vm.expectRevert('active seal');game.commit(keccak256('new'));vm.roll(vm.getBlockNumber()+1);vm.prank(alice);vm.expectRevert('duplicate');game.reveal(0,0,answers[0],salt);}
 function testPausedClaimAndReservedRecovery()public{win(alice);game.setPaused(true);vm.prank(bob);vm.expectRevert('closed');game.commit(keccak256('x'));vm.warp(game.ends());game.recoverUnwon(address(this));assertEq(game.prizeBalance(),5e6);assertEq(token.balanceOf(address(game)),5e6);vm.prank(alice);game.claim();assertEq(token.balanceOf(alice),10e6);}
 function testUnfundedChestNeverReservesOrTakesBribe()public{HauntedContract empty=new HauntedContract(address(this),address(token),answers,5e6,1e6,block.timestamp+1 days);HauntedContract old=game;game=empty;solve(alice,0,0,answers[0]);solve(alice,1,0,answers[1]);bytes32 salt=keccak256('s');commitFor(alice,2,0,answers[2],salt);vm.roll(vm.getBlockNumber()+1);vm.prank(alice);vm.expectRevert('empty chest');game.reveal(2,0,answers[2],salt);assertEq(game.keys(alice),3);game=old;}
 function testExpiredSealCanBeReplacedAndEndedSeasonCannotPlay()public{vm.prank(alice);game.commit(keccak256('first'));vm.roll(vm.getBlockNumber()+81);vm.prank(alice);game.commit(keccak256('second'));vm.warp(game.ends());vm.prank(alice);vm.expectRevert('closed');game.commit(keccak256('third'));vm.prank(alice);vm.expectRevert();game.setPaused(false);}
 function testFuzzCommitBindsSalt(bytes32 salt)public{vm.assume(salt!=bytes32(0));commitFor(alice,0,0,answers[0],salt);vm.roll(vm.getBlockNumber()+1);vm.prank(alice);vm.expectRevert('binding');game.reveal(0,0,answers[0],bytes32(0));}
}
