pragma solidity ^0.8.24;
import 'forge-std/Test.sol';import '@openzeppelin/contracts/token/ERC20/ERC20.sol';import '@openzeppelin/contracts/token/ERC721/ERC721.sol';import '../src/AgentFoundry.sol';
contract FoundryUSDC is ERC20{constructor()ERC20('Fixture USDC','USDC'){}function decimals()public pure override returns(uint8){return 6;}function mint(address a,uint256 n)external{_mint(a,n);}}
/// @notice Local registry double, not official ERC-8004 production evidence.
contract FoundryRegistryDouble is ERC721{uint256 public next=1;mapping(uint256=>string)private uris;constructor()ERC721('Fixture Agent','AGENT'){}function register(string calldata uri)external returns(uint256 id){id=next++;_safeMint(msg.sender,id);uris[id]=uri;}function tokenURI(uint256 id)public view override returns(string memory){return uris[id];}function getAgentWallet(uint256 id)external view returns(address){return ownerOf(id);}}
contract FoundryTest is Test{FoundryUSDC token;FoundryRegistryDouble registry;AgentFoundry factory;FoundryVault vault;address human=address(0xA11CE);address executor=address(0xB0B);address recipient=address(0xCAFE);
function setUp()public{token=new FoundryUSDC();registry=new FoundryRegistryDouble();factory=new AgentFoundry(address(token),address(registry));address[] memory recipients=new address[](1);recipients[0]=recipient;vm.prank(human);vault=FoundryVault(factory.create(executor,keccak256('blueprint'),5e6,1e6,recipients,'https://foundry.invalid/agent'));token.mint(address(vault),20e6);}
function testCreatesOwnerBoundRegisteredIdentity()public view{assertEq(vault.owner(),human);assertEq(vault.executor(),executor);assertEq(registry.ownerOf(vault.identityId()),address(vault));assertTrue(factory.isVault(address(vault)));assertEq(vault.blueprintHash(),keccak256('blueprint'));}
function testOnlyExecutorAndAllowedRecipient()public{vm.expectRevert(bytes('executor'));vault.pay(bytes32(uint256(1)),recipient,1e6);vm.prank(executor);vm.expectRevert(bytes('policy'));vault.pay(bytes32(uint256(1)),human,1e6);}
function testMaxPaymentAndReplay()public{vm.prank(executor);vm.expectRevert(bytes('policy'));vault.pay(bytes32(uint256(1)),recipient,2e6);vm.prank(executor);vault.pay(bytes32(uint256(1)),recipient,1e6);vm.prank(executor);vm.expectRevert(bytes('policy'));vault.pay(bytes32(uint256(1)),recipient,1e6);}
function testDailyBudgetAndNextDay()public{for(uint256 i=1;i<=5;i++){vm.prank(executor);vault.pay(bytes32(i),recipient,1e6);}vm.prank(executor);vm.expectRevert(bytes('daily cap'));vault.pay(bytes32(uint256(6)),recipient,1e6);vm.warp(block.timestamp+1 days);vm.prank(executor);vault.pay(bytes32(uint256(6)),recipient,1e6);assertEq(vault.spent(),1e6);}
function testOnlyOwnerPauseRecipientWithdraw()public{vm.expectRevert(bytes('owner'));vault.setPaused(true);vm.prank(human);vault.setPaused(true);vm.prank(executor);vm.expectRevert(bytes('executor'));vault.pay(bytes32(uint256(1)),recipient,1e6);vm.prank(human);vault.setPaused(false);vm.prank(human);vault.setRecipient(recipient,false);vm.prank(executor);vm.expectRevert(bytes('policy'));vault.pay(bytes32(uint256(1)),recipient,1e6);vm.prank(human);vault.withdraw(20e6);assertEq(token.balanceOf(human),20e6);}
function testObserveHasNoPaymentAuthority()public{address[] memory recipients=new address[](1);recipients[0]=recipient;vm.prank(human);FoundryVault readOnly=FoundryVault(factory.create(executor,keccak256('observe'),0,0,recipients,'https://foundry.invalid/readonly'));token.mint(address(readOnly),1e6);vm.prank(executor);vm.expectRevert(bytes('policy'));readOnly.pay(bytes32(uint256(1)),recipient,1);}
function testInvalidCapsRejected()public{address[] memory r=new address[](0);vm.expectRevert(bytes('limits'));factory.create(executor,bytes32(0),101e6,1e6,r,'https://foundry.invalid/invalid');}
function testFuzzConservation(uint96 amount)public{amount=uint96(bound(amount,1,1e6));vm.prank(executor);vault.pay(bytes32(uint256(1)),recipient,amount);assertEq(token.balanceOf(address(vault))+token.balanceOf(recipient),20e6);assertEq(vault.spent(),amount);}
}
