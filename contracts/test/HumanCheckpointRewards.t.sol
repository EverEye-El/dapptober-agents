pragma solidity ^0.8.24;
import {HumanCheckpointRewards} from "../src/HumanCheckpointRewards.sol";
import {MockUSDC,Vm} from "./Agents.t.sol";
contract MockCheckpointRegistry {address public owner;address public wallet;constructor(address who){owner=who;wallet=who;}function ownerOf(uint256 id) external view returns(address){require(id==1,"unknown agent");return owner;}function getAgentWallet(uint256 id) external view returns(address){require(id==1,"unknown agent");return wallet;}function transfer(address who) external {owner=who;wallet=address(0);}}
contract HumanCheckpointRewardsTest {
 Vm constant vm=Vm(address(uint160(uint256(keccak256("hevm cheat code")))));
 MockUSDC token;HumanCheckpointRewards rewards;address recipient=address(0x1111);bytes32 campaign=keccak256("checkpoint-2026");bytes32 person=keccak256("one human");
 function setUp() public {token=new MockUSDC();rewards=new HumanCheckpointRewards(address(this),address(token),vm.addr(2),campaign,1e6);token.mint(address(rewards),5e6);}
 function signature(HumanCheckpointRewards target,bytes32 who,address to,uint64 deadline,uint256 key) internal returns(bytes memory){bytes32 domain=keccak256(abi.encode(keccak256("EIP712Domain(string name,string version,uint256 chainId,address verifyingContract)"),keccak256("HumanCheckpointRewards"),keccak256("1"),block.chainid,address(target)));bytes32 body=keccak256(abi.encode(keccak256("Claim(bytes32 campaign,bytes32 person,address recipient,uint64 deadline)"),campaign,who,to,deadline));(uint8 v,bytes32 r,bytes32 s)=vm.sign(key,keccak256(abi.encodePacked("\x19\x01",domain,body)));return abi.encodePacked(r,s,v);}
 function testFixedRewardAndReplayAcrossWallets() public {uint64 deadline=uint64(block.timestamp+300);rewards.claim(person,recipient,deadline,signature(rewards,person,recipient,deadline,2));require(token.balanceOf(recipient)==1e6,"reward");require(rewards.claimed(person),"permanent nullifier");address other=address(0x2222);vm.expectRevert();rewards.claim(person,other,deadline,signature(rewards,person,other,deadline,2));}
 function testRecipientTamperAndForgedSigner() public {uint64 deadline=uint64(block.timestamp+300);bytes memory sig=signature(rewards,person,recipient,deadline,2);vm.expectRevert();rewards.claim(person,address(0x2222),deadline,sig);vm.expectRevert();rewards.claim(person,recipient,deadline,signature(rewards,person,recipient,deadline,3));require(!rewards.claimed(person),"failed claim consumed");}
 function testPauseAuthorityAndExpiry() public {vm.prank(recipient);vm.expectRevert();rewards.setPaused(true);rewards.setPaused(true);uint64 deadline=uint64(block.timestamp+300);bytes memory sig=signature(rewards,person,recipient,deadline,2);vm.expectRevert();rewards.claim(person,recipient,deadline,sig);rewards.setPaused(false);vm.warp(block.timestamp+301);vm.expectRevert();rewards.claim(person,recipient,deadline,sig);}
 function testUnfundedClaimDoesNotBurnNullifierAndContractDomain() public {HumanCheckpointRewards other=new HumanCheckpointRewards(address(this),address(token),vm.addr(2),campaign,1e6);uint64 deadline=uint64(block.timestamp+300);bytes memory wrong=signature(rewards,person,recipient,deadline,2);vm.expectRevert();other.claim(person,recipient,deadline,wrong);bytes memory valid=signature(other,person,recipient,deadline,2);vm.expectRevert();other.claim(person,recipient,deadline,valid);require(!other.claimed(person),"unfunded consumed");token.mint(address(other),1e6);other.claim(person,recipient,deadline,valid);}
 function testFuzzNoDuplicatePayout(bytes32 who) public {if(who==bytes32(0))return;uint64 deadline=uint64(block.timestamp+300);bytes memory sig=signature(rewards,who,recipient,deadline,2);rewards.claim(who,recipient,deadline,sig);vm.expectRevert();rewards.claim(who,recipient,deadline,sig);require(token.balanceOf(recipient)==1e6,"duplicate payout");}
}
