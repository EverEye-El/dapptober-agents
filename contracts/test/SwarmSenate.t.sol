pragma solidity ^0.8.24;
import {SenateVoice} from '../src/SenateVoice.sol';
import {SwarmGovernor} from '../src/SwarmGovernor.sol';
import {IGovernor} from '@openzeppelin/contracts/governance/IGovernor.sol';
interface SenateVm {function warp(uint256) external;function prank(address) external;function expectRevert() external;function expectRevert(bytes calldata) external;}
contract SwarmSenateTest {
 SenateVm constant vm=SenateVm(address(uint160(uint256(keccak256('hevm cheat code')))));
 SenateVoice t;SwarmGovernor g;address a=address(0xA);address b=address(0xB);address c=address(0xC);address da=address(0xAA);address db=address(0xBB);address dc=address(0xCC);
 function setUp() public {vm.warp(1000);address[] memory members=new address[](3);members[0]=a;members[1]=b;members[2]=c;t=new SenateVoice(members);g=new SwarmGovernor(t,10,120,60);vm.prank(a);t.delegate(da);vm.prank(b);t.delegate(db);vm.prank(c);t.delegate(dc);vm.warp(1002);}
 function data() internal view returns(address[] memory targets,uint256[] memory amounts,bytes[] memory calls){targets=new address[](1);targets[0]=address(g);amounts=new uint256[](1);calls=new bytes[](1);calls[0]=abi.encodeCall(g.adopt,(keccak256('open policy')));}
 function proposal() internal returns(uint256 id){(address[] memory targets,uint256[] memory amounts,bytes[] memory calls)=data();vm.prank(a);id=g.propose(targets,amounts,calls,'Open policy');vm.warp(g.proposalSnapshot(id)+1);}
 function testHumanOverrideSubtractsDelegateAndDefeatsProposal() public {uint256 id=proposal();vm.prank(da);g.castVote(id,1);vm.prank(db);g.castVote(id,1);vm.prank(dc);g.castVote(id,0);vm.warp(g.agentDeadline(id)+1);vm.prank(a);g.castOverrideVote(id,0,'Protect reserves');(uint256 againstVotes,uint256 forVotes,)=g.proposalVotes(id);require(againstVotes==2e18&&forVotes==1e18,'override failed');vm.warp(g.proposalDeadline(id)+1);require(g.state(id)==IGovernor.ProposalState.Defeated,'wrong outcome');}
 function testOverrideBeforeDelegatePreventsDoubleCountingAndCanExecute() public {uint256 id=proposal();vm.prank(a);g.castOverrideVote(id,0,'Human first');vm.prank(da);g.castVote(id,1);vm.prank(db);g.castVote(id,1);vm.prank(dc);g.castVote(id,1);(uint256 againstVotes,uint256 forVotes,)=g.proposalVotes(id);require(againstVotes==1e18&&forVotes==2e18,'double counted');vm.warp(g.proposalDeadline(id)+1);require(g.state(id)==IGovernor.ProposalState.Succeeded,'majority failed');(address[] memory targets,uint256[] memory amounts,bytes[] memory calls)=data();g.execute(targets,amounts,calls,keccak256('Open policy'));require(g.adoptedResolution()==keccak256('open policy'),'not adopted');}
 function testAgentCutoffAndLateOverrideEnforced() public {uint256 id=proposal();vm.warp(g.agentDeadline(id)+1);vm.prank(da);vm.expectRevert(bytes('human review window'));g.castVote(id,1);vm.prank(a);g.castOverrideVote(id,1,'Review');vm.warp(g.proposalDeadline(id)+1);vm.prank(b);vm.expectRevert();g.castOverrideVote(id,1,'Late');}
 function testDuplicateVotesAndOverridesReject() public {uint256 id=proposal();vm.prank(da);g.castVote(id,1);vm.prank(da);vm.expectRevert();g.castVote(id,0);vm.prank(a);g.castOverrideVote(id,0,'Changed');vm.prank(a);vm.expectRevert();g.castOverrideVote(id,1,'Again');}
 function testUnregisteredWalletNoAuthorityOrTransfer() public {(address[] memory targets,uint256[] memory amounts,bytes[] memory calls)=data();vm.prank(address(99));vm.expectRevert(bytes('members only'));g.propose(targets,amounts,calls,'Injected');vm.prank(a);vm.expectRevert(bytes('nontransferable'));t.transfer(address(99),1e18);vm.expectRevert();g.adopt(keccak256('bypass'));}
 function testSnapshotUnaffectedByRedelegation() public {uint256 id=proposal();vm.prank(a);t.delegate(address(77));vm.prank(da);g.castVote(id,1);vm.prank(a);g.castOverrideVote(id,0,'Keep human authority');(uint256 againstVotes,uint256 forVotes,)=g.proposalVotes(id);require(againstVotes==1e18&&forVotes==0,'snapshot drift');}
 function testOnlyPolicyResolutionTargetsAccepted() public {(address[] memory targets,uint256[] memory amounts,bytes[] memory calls)=data();targets[0]=address(t);vm.prank(a);vm.expectRevert(bytes('resolution only'));g.propose(targets,amounts,calls,'Drain');}
 function testFuzzOverrideNeverAddsExtraWeight(uint8 humanSupport,uint8 agentSupport) public {humanSupport%=3;agentSupport%=3;uint256 id=proposal();vm.prank(da);g.castVote(id,agentSupport);vm.prank(a);g.castOverrideVote(id,humanSupport,'Fuzz');(uint256 againstVotes,uint256 forVotes,uint256 abstainVotes)=g.proposalVotes(id);require(againstVotes+forVotes+abstainVotes==1e18,'inflated weight');}
}
