pragma solidity ^0.8.25;
import {Test} from 'forge-std/Test.sol';import {ERC20} from '@openzeppelin/contracts/token/ERC20/ERC20.sol';import {GroupChatFamiliar} from '../src/GroupChatFamiliar.sol';
contract FamiliarUSDCFixture is ERC20 {constructor() ERC20('Fixture USDC','USDC'){}function decimals() public pure override returns(uint8){return 6;}function mint(address to,uint256 amount) external {_mint(to,amount);}}
contract GroupChatFamiliarTest is Test {FamiliarUSDCFixture token;GroupChatFamiliar social;address alice=address(11);address bob=address(12);address collector=address(13);bytes32 room=keccak256('room');
 function setUp() public {token=new FamiliarUSDCFixture();social=new GroupChatFamiliar(address(token));token.mint(alice,2000e6);token.mint(bob,2000e6);vm.prank(alice);token.approve(address(social),type(uint256).max);vm.prank(bob);token.approve(address(social),type(uint256).max);}
 function testTipExactTransferReplayAndCap() public {vm.prank(alice);social.tip(room,bytes32(uint256(1)),collector,2e6);assertEq(token.balanceOf(collector),2e6);assertEq(token.balanceOf(address(social)),0);assertEq(social.xp(room),20);vm.prank(alice);vm.expectRevert('replay');social.tip(room,bytes32(uint256(1)),collector,2e6);vm.prank(alice);vm.expectRevert('payment bound');social.tip(room,bytes32(uint256(2)),collector,101e6);}
 function testDailyCapAndPause() public {for(uint256 i=1;i<=5;i++){vm.prank(alice);social.tip(room,bytes32(i),collector,100e6);}vm.prank(alice);vm.expectRevert('daily cap');social.tip(room,bytes32(uint256(6)),collector,1e6);vm.warp(block.timestamp+1 days);vm.prank(alice);social.tip(room,bytes32(uint256(6)),collector,1e6);vm.prank(alice);vm.expectRevert('guardian');social.pause(true);social.pause(true);vm.prank(bob);vm.expectRevert('payment bound');social.tip(room,bytes32(uint256(7)),collector,1);}
 function testBillRemainderAndDuplicatePayment() public {bytes32 id=bytes32(uint256(3));social.createBill(room,id,collector,1000001,3);assertEq(social.share(id),333334);vm.prank(alice);social.payBill(id);assertEq(social.share(id),333334);vm.prank(alice);vm.expectRevert('already paid');social.payBill(id);vm.prank(bob);social.payBill(id);token.mint(address(this),1e6);token.approve(address(social),1e6);social.payBill(id);assertEq(token.balanceOf(collector),1000001);vm.prank(address(999));vm.expectRevert('bill closed');social.payBill(id);}
 function testFuzzBillConservesEveryMicroUSDC(uint64 total,uint8 people) public {people=uint8(bound(people,2,10));total=uint64(bound(total,people,uint256(people)*100e6));bytes32 id=bytes32(uint256(9));social.createBill(room,id,collector,total,people);for(uint256 i=1;i<=people;i++){address payer=address(uint160(100+i));token.mint(payer,100e6);vm.startPrank(payer);token.approve(address(social),100e6);social.payBill(id);vm.stopPrank();}assertEq(token.balanceOf(collector),total);assertEq(token.balanceOf(address(social)),0);}
 function testPollLiveTallyOneWalletAndDeadline() public {string[] memory choices=new string[](2);choices[0]='Pizza';choices[1]='Tacos';bytes32 id=bytes32(uint256(4));social.createPoll(room,id,'Dinner?',choices,uint64(block.timestamp+600));vm.prank(alice);social.vote(id,1);vm.prank(alice);vm.expectRevert(bytes('vote'));social.vote(id,0);(,,,,,uint256[] memory votes)=social.getPoll(id);assertEq(votes[1],1);vm.warp(block.timestamp+601);vm.prank(bob);vm.expectRevert(bytes('vote'));social.vote(id,0);}
 function testPollAndBillCannotOverwrite() public {string[] memory choices=new string[](2);choices[0]='Pizza';choices[1]='Pizza';vm.expectRevert('duplicate choice');social.createPoll(room,bytes32(uint256(1)),'?',choices,uint64(block.timestamp+600));social.createBill(room,bytes32(uint256(1)),collector,2e6,2);vm.expectRevert(bytes('bill'));social.createBill(room,bytes32(uint256(1)),bob,3e6,2);}
 function testMemeOwnerMetadataAndNonce() public {string memory uri='data:application/json;base64,eyJuYW1lIjoiZ3JlbWxpbiJ9';vm.prank(alice);social.mintMeme(room,bytes32(uint256(5)),uri);assertEq(social.ownerOf(1),alice);assertEq(social.tokenURI(1),uri);assertEq(social.xp(room),30);vm.prank(alice);vm.expectRevert('replay');social.mintMeme(room,bytes32(uint256(5)),uri);}
 function testRejectedTransferRollsBackReplayAndSpend() public {address empty=address(99);vm.prank(empty);vm.expectRevert();social.tip(room,bytes32(uint256(8)),collector,1e6);assertFalse(social.used(empty,bytes32(uint256(8))));assertEq(social.spent(empty,block.timestamp/1 days),0);}
}
