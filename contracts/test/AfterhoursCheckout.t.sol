pragma solidity ^0.8.24;
import 'forge-std/Test.sol';import '@openzeppelin/contracts/token/ERC20/ERC20.sol';import '../src/AfterhoursCheckout.sol';
contract MallUSDC is ERC20{constructor()ERC20('Fixture USDC','USDC'){}function decimals()public pure override returns(uint8){return 6;}function mint(address who,uint256 amount)external{_mint(who,amount);}}
contract AfterhoursTest is Test{
 MallUSDC token;AfterhoursCheckout shop;address buyer=address(0xA11CE);address seller=address(0xCAFE);address arbiter=address(0xB0B);uint256 quoteKey;address signer;
 function setUp()public{(signer,quoteKey)=makeAddrAndKey('merchant-quote-fixture');token=new MallUSDC();shop=new AfterhoursCheckout(address(token),signer,arbiter);token.mint(buyer,1000e6);vm.prank(buyer);token.approve(address(shop),1000e6);}
 function quote(uint256 id,uint256 amount)internal view returns(AfterhoursCheckout.Quote memory){return AfterhoursCheckout.Quote(bytes32(id),keccak256('product-v1'),buyer,seller,amount,block.timestamp+300);}
 function signature(AfterhoursCheckout.Quote memory q)internal view returns(bytes memory){bytes32 domain=keccak256(abi.encode(keccak256('EIP712Domain(string name,string version,uint256 chainId,address verifyingContract)'),keccak256('AfterhoursCheckout'),keccak256('1'),block.chainid,address(shop)));bytes32 digest=keccak256(abi.encodePacked('\x19\x01',domain,keccak256(abi.encode(shop.QUOTE_TYPEHASH(),q.id,q.itemHash,q.buyer,q.seller,q.amount,q.expiry))));(uint8 v,bytes32 r,bytes32 s)=vm.sign(quoteKey,digest);return abi.encodePacked(r,s,v);}
 function buy(uint256 id,uint256 amount)internal{AfterhoursCheckout.Quote memory q=quote(id,amount);bytes memory sig=signature(q);vm.prank(buyer);shop.buy(q,sig);}
 function testPurchaseReservesExactUSDC()public{buy(1,4e6);assertEq(token.balanceOf(address(shop)),4e6);assertEq(shop.reserved(),4e6);assertEq(token.balanceOf(seller),0);}
 function testOnlyBoundBuyerAndUnmodifiedQuote()public{AfterhoursCheckout.Quote memory q=quote(1,4e6);bytes memory sig=signature(q);vm.expectRevert(bytes('buyer'));shop.buy(q,sig);q.amount=5e6;vm.prank(buyer);vm.expectRevert(bytes('quote'));shop.buy(q,sig);}
 function testReplayAndExpiredQuotesRejected()public{buy(1,4e6);AfterhoursCheckout.Quote memory q=quote(1,4e6);bytes memory sig=signature(q);vm.prank(buyer);vm.expectRevert(bytes('order'));shop.buy(q,sig);q=quote(2,4e6);sig=signature(q);vm.warp(block.timestamp+301);vm.prank(buyer);vm.expectRevert(bytes('expiry'));shop.buy(q,sig);}
 function testRefundReturnsAllAndCannotRepeat()public{buy(1,4e6);vm.prank(seller);shop.refund(bytes32(uint256(1)));assertEq(token.balanceOf(buyer),1000e6);assertEq(shop.reserved(),0);vm.prank(seller);vm.expectRevert(bytes('refund'));shop.refund(bytes32(uint256(1)));}
 function testStrangerCannotRefundReleaseOrResolve()public{buy(1,4e6);vm.expectRevert(bytes('refund'));shop.refund(bytes32(uint256(1)));vm.expectRevert(bytes('release'));shop.release(bytes32(uint256(1)));vm.expectRevert(bytes('arbiter'));shop.resolve(bytes32(uint256(1)),true);}
 function testBuyerAcceptancePaysOnlySeller()public{buy(1,4e6);vm.prank(buyer);shop.accept(bytes32(uint256(1)));assertEq(token.balanceOf(seller),4e6);assertEq(shop.reserved(),0);}
 function testDisputeFreezesReleaseUntilArbiter()public{buy(1,4e6);vm.prank(buyer);shop.dispute(bytes32(uint256(1)),keccak256('salted issue'));vm.warp(block.timestamp+3 days);vm.prank(seller);vm.expectRevert(bytes('release'));shop.release(bytes32(uint256(1)));vm.prank(buyer);vm.expectRevert(bytes('accept'));shop.accept(bytes32(uint256(1)));vm.prank(arbiter);shop.resolve(bytes32(uint256(1)),true);assertEq(token.balanceOf(buyer),1000e6);}
 function testArbiterCanPayMerchantOnDispute()public{buy(1,4e6);vm.prank(buyer);shop.dispute(bytes32(uint256(1)),keccak256('issue'));vm.prank(arbiter);shop.resolve(bytes32(uint256(1)),false);assertEq(token.balanceOf(seller),4e6);}
 function testTimedReleaseNeedsSellerTransaction()public{buy(1,4e6);vm.prank(seller);vm.expectRevert(bytes('release'));shop.release(bytes32(uint256(1)));vm.warp(block.timestamp+2 days);assertEq(token.balanceOf(seller),0);vm.prank(seller);shop.release(bytes32(uint256(1)));assertEq(token.balanceOf(seller),4e6);}
 function testHardAmountCapAndSelfTradeRejected()public{AfterhoursCheckout.Quote memory q=quote(1,1001e6);bytes memory sig=signature(q);vm.prank(buyer);vm.expectRevert(bytes('order'));shop.buy(q,sig);q=quote(2,4e6);q.seller=buyer;sig=signature(q);vm.prank(buyer);vm.expectRevert(bytes('buyer'));shop.buy(q,sig);}
 function testFuzzConservationAcrossRefundAndRelease(uint96 amount,bool refundBuyer)public{amount=uint96(bound(amount,1,1000e6));buy(1,amount);if(refundBuyer){vm.prank(seller);shop.refund(bytes32(uint256(1)));}else{vm.prank(buyer);shop.accept(bytes32(uint256(1)));}assertEq(token.balanceOf(buyer)+token.balanceOf(seller)+token.balanceOf(address(shop)),1000e6);assertEq(shop.reserved(),0);}
}
