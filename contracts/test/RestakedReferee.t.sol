pragma solidity ^0.8.25;
import {Test} from 'forge-std/Test.sol';import {ERC20} from '@openzeppelin/contracts/token/ERC20/ERC20.sol';import {ERC4626} from '@openzeppelin/contracts/token/ERC20/extensions/ERC4626.sol';import {IERC20} from '@openzeppelin/contracts/token/ERC20/IERC20.sol';import {RestakedReferee,IRefereeValidation} from '../src/RestakedReferee.sol';
contract RefereeUSDC is ERC20 {constructor() ERC20('Fixture USDC','USDC'){}function decimals() public pure override returns(uint8){return 6;}function mint(address a,uint256 n) external {_mint(a,n);}}
contract RefereeVault is ERC4626 {constructor(IERC20 token) ERC20('Fixture receipt','rUSDC') ERC4626(token){}}
contract RefereeRegistryFixture is IRefereeValidation {address validator;uint256 agent;uint8 public response;bytes32 public responseHash;function request(address a,uint256 id) external {validator=a;agent=id;}function getValidationStatus(bytes32) external view returns(address,uint256,uint8,bytes32,string memory,uint256){return(validator,agent,response,responseHash,'',0);}function validationResponse(bytes32,uint8 r,string calldata,bytes32 h,string calldata) external {require(msg.sender==validator,'validator');response=r;responseHash=h;}}
contract RestakedRefereeTest is Test {RefereeUSDC token;RefereeVault vault;RestakedReferee referee;uint256 key=12345;address operator;function setUp() public {token=new RefereeUSDC();vault=new RefereeVault(token);referee=new RestakedReferee(address(token),address(vault),address(0),60);operator=vm.addr(key);token.mint(operator,100e6);vm.startPrank(operator);token.approve(address(referee),100e6);referee.register(100e6,99e6);vm.stopPrank();}
 function task(int256 claimed) internal returns(bytes32){int64[] memory inputs=new int64[](3);inputs[0]=12;inputs[1]=24;inputs[2]=-6;return referee.createTask(1,0,inputs,claimed,bytes32(uint256(1)));}
 function report(bytes32 id,bool passed) internal returns(bytes32){bytes32 evidence=keccak256('evidence');uint256 deadline=block.timestamp+300;bytes32 digest=referee.verdictDigest(id,operator,passed,evidence,deadline);(uint8 v,bytes32 r,bytes32 s)=vm.sign(key,digest);return referee.submitVerdict(id,operator,passed,evidence,deadline,abi.encodePacked(r,s,v));}
 function testTaskCommitmentBindsCreator() public {int64[] memory inputs=new int64[](1);inputs[0]=3;bytes32 mine=referee.createTask(1,0,inputs,3,bytes32(0));vm.prank(address(77));bytes32 copied=referee.createTask(1,0,inputs,3,bytes32(0));assertTrue(mine!=copied);}
 function testHonestReleaseAndLockedWithdrawal() public {bytes32 id=report(task(30),true);vm.prank(operator);vm.expectRevert('locked collateral');referee.withdraw(100e6);vm.expectRevert('honest verdict');referee.challenge(id);vm.expectRevert('review active/settled');referee.settle(id);vm.warp(block.timestamp+61);referee.settle(id);(uint256 shares,uint256 locked,,uint256 slashes)=referee.operators(operator);assertEq(shares,100e6);assertEq(locked,0);assertEq(slashes,0);vm.prank(operator);referee.withdraw(shares);assertEq(vault.balanceOf(operator),100e6);vm.prank(operator);uint256 assets=vault.redeem(100e6,operator,operator);assertEq(assets,100e6);}
 function testDishonestChallengeSlashAndEvidence() public {bytes32 id=report(task(99),true);referee.challenge(id);(,,,,,,uint8 status)=referee.reports(id);assertEq(status,2);vm.warp(block.timestamp+61);referee.settle(id);assertEq(vault.balanceOf(address(this)),10e6);(uint256 shares,uint256 locked,,uint256 slashes)=referee.operators(operator);assertEq(shares,90e6);assertEq(locked,0);assertEq(slashes,1);vm.expectRevert('review active/settled');referee.settle(id);assertEq(vault.redeem(10e6,address(this),address(this)),10e6);}
 function testUnchallengedLieStillSlashed() public {bytes32 id=report(task(99),true);vm.warp(block.timestamp+61);referee.settle(id);assertEq(vault.balanceOf(address(this)),10e6);}
 function testWrongSignatureReplayAndDomain() public {bytes32 t=task(30);bytes32 id=report(t,true);uint256 replayEnd=block.timestamp+300;bytes32 replayDigest=referee.verdictDigest(t,operator,true,keccak256('evidence'),replayEnd);(uint8 rv,bytes32 rr,bytes32 rs)=vm.sign(key,replayDigest);vm.expectRevert('duplicate verdict');referee.submitVerdict(t,operator,true,keccak256('evidence'),replayEnd,abi.encodePacked(rr,rs,rv));uint256 deadline=block.timestamp+300;bytes32 h=referee.verdictDigest(t,operator,false,keccak256('evidence'),deadline);(uint8 v,bytes32 r,bytes32 s)=vm.sign(9876,h);vm.expectRevert('signature');referee.submitVerdict(t,operator,false,keccak256('evidence'),deadline,abi.encodePacked(r,s,v));assertTrue(id!=bytes32(0));}
 function testPausePreservesSettlementAndExit() public {bytes32 id=report(task(30),true);referee.pause(true);vm.expectRevert('paused');task(30);vm.warp(block.timestamp+61);referee.settle(id);vm.prank(operator);referee.withdraw(100e6);}
 function testRegistryFinalResponse() public {RefereeRegistryFixture registry=new RefereeRegistryFixture();RestakedReferee linked=new RestakedReferee(address(token),address(vault),address(registry),60);int64[] memory inputs=new int64[](1);inputs[0]=3;vm.expectRevert('registry request');linked.createTask(1,0,inputs,3,bytes32(0));registry.request(address(linked),1);bytes32 t=linked.createTask(1,0,inputs,3,bytes32(0));token.mint(operator,20e6);vm.startPrank(operator);token.approve(address(linked),20e6);linked.register(20e6,20e6);vm.stopPrank();uint256 end=block.timestamp+300;bytes32 evidence=keccak256('evidence');(uint8 v,bytes32 r,bytes32 s)=vm.sign(key,linked.verdictDigest(t,operator,true,evidence,end));bytes32 id=linked.submitVerdict(t,operator,true,evidence,end,abi.encodePacked(r,s,v));vm.expectRevert('final/registry');linked.publishValidation(id,'data:fixture');vm.warp(block.timestamp+61);linked.settle(id);linked.publishValidation(id,'data:fixture');assertEq(registry.response(),100);assertTrue(registry.responseHash()!=bytes32(0));}
 function testFuzzSumAndMax(int64 a,int64 b,int64 c) public view {int64[] memory values=new int64[](3);values[0]=a;values[1]=b;values[2]=c;assertEq(referee.rerun(0,values),int256(a)+int256(b)+int256(c));int256 max=a>b?a:b;if(c>max)max=c;assertEq(referee.rerun(1,values),max);}
 function testCollateralConservationAfterYield() public {token.mint(address(vault),100e6);bytes32 id=report(task(99),true);vm.warp(block.timestamp+61);referee.settle(id);assertApproxEqAbs(vault.convertToAssets(vault.balanceOf(address(this))),10e6,2);(uint256 shares,uint256 locked,,)=referee.operators(operator);assertEq(shares+vault.balanceOf(address(this)),100e6);assertEq(locked,0);}
}
