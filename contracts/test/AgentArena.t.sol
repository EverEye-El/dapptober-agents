pragma solidity ^0.8.24;
import {Test} from 'forge-std/Test.sol';
import {AgentArena,IArenaVRF} from '../src/AgentArena.sol';
import {ERC20} from '@openzeppelin/contracts/token/ERC20/ERC20.sol';
contract ArenaUSDCFixture is ERC20 {constructor() ERC20('Fixture USDC','USDC'){}function mint(address a,uint256 n) external{_mint(a,n);}function decimals() public pure override returns(uint8){return 6;}}
contract ArenaVRFFixture is IArenaVRF {uint256 public nonce;mapping(uint256=>address) public consumers;function requestRandomWords(Request calldata r) external returns(uint256 id){require(r.numWords==1&&r.requestConfirmations==3,'request');id=++nonce;consumers[id]=msg.sender;}function fulfill(uint256 id,uint256 seed) external{uint256[] memory words=new uint256[](1);words[0]=seed;AgentArena(consumers[id]).rawFulfillRandomWords(id,words);}}
contract AgentArenaTest is Test {AgentArena arena;ArenaUSDCFixture token;ArenaVRFFixture vrf;address trainerA=address(11);address trainerB=address(12);address pilotA=address(21);address pilotB=address(22);address alice=address(31);address bob=address(32);address house=address(41);uint256 id;bytes32 salt=keccak256('fixture salt');uint8[3] a=[uint8(0),0,0];uint8[3] b=[uint8(2),2,2];
 function setUp() public{vm.chainId(31337);token=new ArenaUSDCFixture();vrf=new ArenaVRFFixture();arena=new AgentArena(address(token),house,address(this),address(vrf),bytes32(uint256(1)),1);vm.prank(trainerA);arena.register(pilotA,bytes32('Rivet'),keccak256('strategy-a'));vm.prank(trainerB);arena.register(pilotB,bytes32('Hex'),keccak256('strategy-b'));arena.enroll(1,true);arena.enroll(2,true);id=arena.schedule(1,2,uint64(block.timestamp+60));for(uint256 i;i<2;i++){address who=i==0?alice:bob;token.mint(who,100e6);vm.prank(who);token.approve(address(arena),100e6);}}
 function bets(uint256 aa,uint256 bb) internal{vm.prank(alice);arena.stake(id,0,aa);vm.prank(bob);arena.stake(id,1,bb);}
 function commitBoth() internal{vm.warp(block.timestamp+60);bytes32 ca=arena.commitment(id,0,a,salt);bytes32 cb=arena.commitment(id,1,b,salt);vm.prank(pilotA);arena.commit(id,0,ca);vm.prank(pilotB);arena.commit(id,1,cb);arena.requestArena(id);}
 function revealBoth() internal{vrf.fulfill(1,7);vm.prank(pilotA);arena.reveal(id,0,a,salt);vm.prank(pilotB);arena.reveal(id,1,b,salt);}
 function testWinnerProfitTrainerAndHouseConserve() public{bets(10e6,20e6);commitBoth();revealBoth();arena.settle(id);assertEq(arena.credit(alice),28e6);assertEq(arena.credit(bob),0);assertEq(arena.credit(trainerA),1e6);assertEq(arena.credit(house),1e6);assertEq(arena.liability(),30e6);vm.prank(alice);arena.claim();assertEq(token.balanceOf(alice),118e6);assertEq(arena.liability(),2e6);vm.prank(alice);vm.expectRevert();arena.claim();vm.expectRevert();arena.settle(id);}
 function testDrawRefundNoHouse() public{b=a;bets(10e6,20e6);commitBoth();revealBoth();arena.settle(id);assertEq(arena.credit(alice),10e6);assertEq(arena.credit(bob),20e6);assertEq(arena.credit(house),0);(,,,uint32 points)=arena.ladder(uint32(block.timestamp/30 days),1);assertEq(points,1);}
 function testLateStakeAndPilotRejected() public{token.mint(pilotA,1e6);vm.prank(pilotA);vm.expectRevert(bytes('pilot cannot stake'));arena.stake(id,0,1e6);vm.warp(block.timestamp+60);vm.prank(alice);vm.expectRevert(bytes('closed'));arena.stake(id,0,1e6);}
 function testCommitBeforeCloseUnauthorizedAndOverwriteRejected() public{bytes32 ca=arena.commitment(id,0,a,salt);vm.prank(pilotA);vm.expectRevert();arena.commit(id,0,ca);vm.warp(block.timestamp+60);vm.prank(bob);vm.expectRevert();arena.commit(id,0,ca);vm.prank(pilotA);arena.commit(id,0,ca);vm.prank(pilotA);vm.expectRevert();arena.commit(id,0,ca);}
 function testOnlyCoordinatorAndNoReRequest() public{commitBoth();uint256[] memory words=new uint256[](1);vm.expectRevert(bytes('coordinator'));arena.rawFulfillRandomWords(1,words);vm.expectRevert();arena.requestArena(id);}
 function testWrongSaltAndCrossMatchRevealRejected() public{commitBoth();vrf.fulfill(1,8);vm.prank(pilotA);vm.expectRevert();arena.reveal(id,0,a,bytes32(uint256(1)));assertTrue(arena.commitment(id,0,a,salt)!=arena.commitment(id+1,0,a,salt));}
 function testWithholdingForfeitsAfterDeadline() public{bets(10e6,20e6);commitBoth();vrf.fulfill(1,8);vm.prank(pilotA);arena.reveal(id,0,a,salt);vm.warp(block.timestamp+300);arena.settle(id);assertEq(arena.credit(alice),28e6);}
 function testMissingOracleRefundLateCallbackCannotResettle() public{bets(10e6,20e6);commitBoth();vm.warp(block.timestamp+1 days);arena.settle(id);vrf.fulfill(1,8);assertEq(arena.matchInfo(id).status,5);assertEq(arena.credit(alice),10e6);assertEq(arena.credit(house),0);}
 function testNoRevealsRefundsAndPausePreservesExits() public{bets(10e6,20e6);commitBoth();vrf.fulfill(1,8);arena.setPaused(true);vm.warp(block.timestamp+300);arena.settle(id);vm.prank(alice);arena.claim();assertEq(token.balanceOf(alice),100e6);}
 function testNoWinningBackersRefundNoFees() public{vm.prank(bob);arena.stake(id,1,20e6);commitBoth();revealBoth();arena.settle(id);assertEq(arena.credit(bob),20e6);assertEq(arena.credit(house),0);}
 function testFrozenStrategySurvivesTraining() public{bytes32 beforeHash=arena.matchInfo(id).strategies[0];vm.prank(trainerA);arena.train(1,keccak256('new-strategy'));assertEq(arena.matchInfo(id).strategies[0],beforeHash);}
 function testTrainerCanBackOwnFighterBeforeCommit() public{token.mint(trainerA,1e6);vm.startPrank(trainerA);token.approve(address(arena),1e6);arena.stake(id,0,1e6);vm.stopPrank();assertEq(arena.stakes(id,trainerA,0),1e6);}
 function testUnapprovedFighterCannotConsumeVRFBudget() public{vm.prank(alice);uint256 unapproved=arena.register(alice,bytes32('unapproved'),keccak256('policy'));vm.expectRevert(bytes('lineup'));arena.schedule(unapproved,1,uint64(block.timestamp+60));}
 function testLateOracleCannotChangeFixedRefundDeadline() public{bets(10e6,20e6);commitBoth();vm.warp(block.timestamp+1 days);vrf.fulfill(1,8);assertEq(arena.matchInfo(id).status,2);arena.settle(id);assertEq(arena.credit(alice),10e6);}
 function testFuzzPayoutConservation(uint64 x,uint64 y) public{uint256 aa=bound(x,1,100e6);uint256 bb=bound(y,1,100e6);bets(aa,bb);commitBoth();revealBoth();arena.settle(id);assertEq(arena.credit(alice)+arena.credit(bob)+arena.credit(trainerA)+arena.credit(house),aa+bb);assertEq(token.balanceOf(address(arena)),aa+bb);}
}
