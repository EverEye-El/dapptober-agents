pragma solidity ^0.8.24;
import {SessionVault} from "../src/SessionVault.sol";
import {QuestEscrow} from "../src/QuestEscrow.sol";
import {FlightTreasury} from "../src/FlightTreasury.sol";
import {AgentPassport} from "../src/AgentPassport.sol";
import {ERC20} from "@openzeppelin/contracts/token/ERC20/ERC20.sol";
import {ERC4626} from "@openzeppelin/contracts/token/ERC20/extensions/ERC4626.sol";
import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
interface Vm {function addr(uint256) external returns(address);function sign(uint256,bytes32) external returns(uint8,bytes32,bytes32);function prank(address) external;function startPrank(address) external;function stopPrank() external;function warp(uint256) external;function expectRevert() external;function expectRevert(bytes calldata) external;}
contract MockUSDC is ERC20 {constructor() ERC20("USDC","USDC") {}function decimals() public pure override returns(uint8){return 6;}function mint(address to,uint256 amount) external {_mint(to,amount);}}
contract MockVault is ERC4626 {constructor(IERC20 token) ERC20("Savings","SAVE") ERC4626(token) {} }
contract AgentsTest {
 Vm constant vm=Vm(address(uint160(uint256(keccak256("hevm cheat code")))));
 MockUSDC token;address owner;address agent;address client;address validator;uint256 constant AGENT_KEY=2;uint256 constant OWNER_KEY=1;uint256 constant CLIENT_KEY=3;
 function setUp() public {owner=vm.addr(OWNER_KEY);agent=vm.addr(AGENT_KEY);client=vm.addr(CLIENT_KEY);validator=vm.addr(4);token=new MockUSDC();token.mint(owner,10000e6);}
 function signature(uint256 key,bytes32 digest) internal returns(bytes memory){(uint8 v,bytes32 r,bytes32 s)=vm.sign(key,digest);return abi.encodePacked(r,s,v);}
 function session() internal returns(SessionVault v){v=new SessionVault(owner);token.mint(address(v),100e6);vm.startPrank(owner);v.allowToken(address(token),true);v.allowRecipient(client,true);v.grant(agent,25e6,25e6,5e6,block.timestamp+1 days);vm.stopPrank();}
 function testSessionTransferCapAndReplay() public {SessionVault v=session();uint256 deadline=block.timestamp+300;bytes memory sig=signature(AGENT_KEY,v.digest(address(token),client,5e6,deadline,false,bytes32(uint256(1))));v.transfer(address(token),client,5e6,deadline,false,bytes32(uint256(1)),sig,"");require(token.balanceOf(client)==5e6,"transfer failed");vm.expectRevert();v.transfer(address(token),client,5e6,deadline,false,bytes32(uint256(1)),sig,"");bytes32 d=v.digest(address(token),client,21e6,deadline,false,bytes32(uint256(1)));bytes memory a=signature(AGENT_KEY,d);bytes memory o=signature(OWNER_KEY,d);vm.expectRevert(bytes("daily cap"));v.transfer(address(token),client,21e6,deadline,false,bytes32(uint256(1)),a,o);}
 function testSessionHumanCosign() public {SessionVault v=session();uint256 deadline=block.timestamp+300;bytes32 d=v.digest(address(token),client,4e6,deadline,true,bytes32(uint256(1)));bytes memory a=signature(AGENT_KEY,d);vm.expectRevert(bytes("owner cosign"));v.transfer(address(token),client,4e6,deadline,true,bytes32(uint256(1)),a,"");v.transfer(address(token),client,4e6,deadline,true,bytes32(uint256(1)),a,signature(OWNER_KEY,d));require(token.balanceOf(client)==4e6,"cosign transfer failed");}
 function testSessionRejectUnauthorizedAndExpiry() public {SessionVault v=session();uint256 deadline=block.timestamp+300;bytes32 d=v.digest(address(token),client,1e6,deadline,false,bytes32(uint256(1)));bytes memory bad=signature(CLIENT_KEY,d);vm.expectRevert(bytes("agent signature"));v.transfer(address(token),client,1e6,deadline,false,bytes32(uint256(1)),bad,"");vm.warp(block.timestamp+1 days+1);vm.expectRevert(bytes("inactive session"));v.transfer(address(token),client,1e6,deadline,false,bytes32(uint256(1)),signature(AGENT_KEY,d),"");}
 function testSessionRevokeInvalidatesSignatures() public {SessionVault v=session();uint256 deadline=block.timestamp+300;bytes memory a=signature(AGENT_KEY,v.digest(address(token),client,1e6,deadline,false,bytes32(uint256(1))));vm.prank(owner);v.revoke();vm.expectRevert(bytes("inactive session"));v.transfer(address(token),client,1e6,deadline,false,bytes32(uint256(1)),a,"");vm.prank(owner);v.grant(agent,25e6,25e6,5e6,block.timestamp+1 days);vm.expectRevert(bytes("agent signature"));v.transfer(address(token),client,1e6,deadline,false,bytes32(uint256(1)),a,"");}
 function testSessionAllowlistAndInsufficientBalance() public {SessionVault v=session();uint256 deadline=block.timestamp+300;vm.expectRevert(bytes("not allowed"));v.transfer(address(token),validator,1e6,deadline,false,bytes32(uint256(1)),"","");vm.startPrank(owner);v.recover(address(token),100e6);vm.stopPrank();bytes memory a=signature(AGENT_KEY,v.digest(address(token),client,1e6,deadline,false,bytes32(uint256(1))));vm.expectRevert();v.transfer(address(token),client,1e6,deadline,false,bytes32(uint256(1)),a,"");require(v.nonce()==0,"failed transfer consumed nonce");}
 function testSessionMaxTransactionAndRequestIdReplay() public {SessionVault v=session();vm.prank(owner);v.grant(agent,25e6,3e6,5e6,block.timestamp+1 days);uint256 deadline=block.timestamp+300;bytes32 request=keccak256("same-preview");vm.expectRevert(bytes("maximum transaction"));v.transfer(address(token),client,4e6,deadline,false,request,"","");bytes memory a=signature(AGENT_KEY,v.digest(address(token),client,2e6,deadline,false,request));v.transfer(address(token),client,2e6,deadline,false,request,a,"");a=signature(AGENT_KEY,v.digest(address(token),client,2e6,deadline,false,request));vm.expectRevert(bytes("request replay"));v.transfer(address(token),client,2e6,deadline,false,request,a,"");}
 function escrow() internal returns(QuestEscrow e,uint256 id){e=new QuestEscrow(address(token));vm.startPrank(owner);token.approve(address(e),10e6);id=e.create("Summarize source",10e6,block.timestamp+1 days,validator);vm.stopPrank();}
 function testEscrowLifecycleAndNoDoublePay() public {(QuestEscrow e,uint256 id)=escrow();vm.prank(agent);e.claim(id);vm.prank(agent);e.submit(id,keccak256("output"),"data:text/plain,output");vm.prank(client);vm.expectRevert(bytes("not approver"));e.approve(id);vm.prank(owner);e.approve(id);require(token.balanceOf(agent)==10e6,"worker unpaid");require(token.balanceOf(address(e))==0,"escrow not released");vm.prank(owner);vm.expectRevert();e.approve(id);}
 function testEscrowDisputeValidatorRefund() public {(QuestEscrow e,uint256 id)=escrow();vm.prank(agent);e.claim(id);vm.prank(agent);e.submit(id,keccak256("bad"),"data:text/plain,bad");vm.prank(owner);e.dispute(id);vm.prank(agent);vm.expectRevert(bytes("not validator"));e.resolve(id,true);vm.prank(validator);e.resolve(id,false);require(token.balanceOf(owner)==10000e6,"creator not refunded");require(token.balanceOf(agent)==0,"bad work paid");}
 function testEscrowTimeoutOpenRefundAndSubmittedPay() public {(QuestEscrow e,uint256 id)=escrow();vm.warp(block.timestamp+1 days+1);e.timeout(id);require(token.balanceOf(owner)==10000e6,"refund timeout");(e,id)=escrow();vm.prank(agent);e.claim(id);vm.prank(agent);e.submit(id,keccak256("ok"),"data:text/plain,ok");vm.warp(block.timestamp+2 days+1);e.timeout(id);require(token.balanceOf(agent)==10e6,"review timeout pay");}
 function testEscrowDisputeTimeoutCannotLockFunds() public {(QuestEscrow e,uint256 id)=escrow();vm.prank(agent);e.claim(id);vm.prank(agent);e.submit(id,keccak256("bad"),"data:text/plain,bad");vm.prank(owner);e.dispute(id);vm.warp(block.timestamp+2 days+1);e.timeout(id);require(token.balanceOf(owner)==10000e6,"dispute timeout refund");}
 function treasury() internal returns(FlightTreasury t,MockVault v){t=new FlightTreasury(owner,address(token));v=new MockVault(token);token.mint(address(t),1000e6);vm.startPrank(owner);t.setVault(address(v),5000,1,true);t.setPlan(agent,250e6,2000,1,500e6,block.timestamp+1 days);vm.stopPrank();}
 function testTreasuryRebalanceAndWithdrawAll() public {(FlightTreasury t,MockVault v)=treasury();vm.prank(agent);t.deposit(address(v),250e6,1,keccak256("reason"));require(t.totalAssets()==1000e6,"treasury accounting");require(token.balanceOf(address(t))==750e6,"liquid balance");vm.prank(owner);t.withdrawAll();require(t.paused() && t.agent()==address(0),"withdraw did not disengage");require(token.balanceOf(owner)==11000e6,"withdraw all lost money");}
 function testTreasuryMaximumAllocationAndDailyCap() public {(FlightTreasury t,MockVault v)=treasury();vm.startPrank(agent);t.deposit(address(v),250e6,1,keccak256("move1"));t.deposit(address(v),250e6,1,keccak256("move2"));vm.expectRevert(bytes("daily cap"));t.deposit(address(v),1e6,1,0);vm.stopPrank();vm.prank(owner);t.setPlan(agent,250e6,2000,1,1000e6,block.timestamp+1 days);vm.prank(agent);vm.expectRevert(bytes("allocation"));t.deposit(address(v),1e6,1,0);}
 function testTreasuryLiquidityRiskAndPause() public {(FlightTreasury t,MockVault v)=treasury();vm.prank(owner);t.setPlan(agent,250e6,9000,0,1000e6,block.timestamp+1 days);vm.prank(agent);vm.expectRevert(bytes("policy"));t.deposit(address(v),200e6,1,0);vm.prank(owner);t.setPlan(agent,250e6,9000,1,1000e6,block.timestamp+1 days);vm.prank(agent);vm.expectRevert(bytes("liquidity"));t.deposit(address(v),200e6,1,0);vm.prank(owner);t.disengage();vm.prank(agent);vm.expectRevert(bytes("inactive"));t.deposit(address(v),1e6,1,0);}
 function testTreasurySlippageAndUnauthorizedPlan() public {(FlightTreasury t,MockVault v)=treasury();vm.prank(client);vm.expectRevert();t.setPlan(client,1e6,0,3,100e6,block.timestamp+1 days);vm.prank(agent);vm.expectRevert(bytes("slippage"));t.deposit(address(v),10e6,type(uint256).max,0);require(token.balanceOf(address(t))==1000e6,"slippage moved assets");}
 function testTreasuryWithdrawalCapPauseAndRequestReplay() public {(FlightTreasury t,MockVault v)=treasury();vm.prank(agent);t.deposit(address(v),250e6,1,keccak256("deposit"));bytes32 reason=keccak256("release");vm.prank(agent);t.withdraw(address(v),100e6,type(uint256).max,reason);require(token.balanceOf(address(t))==850e6,"release failed");vm.prank(agent);vm.expectRevert(bytes("request replay"));t.withdraw(address(v),1e6,type(uint256).max,reason);vm.prank(agent);vm.expectRevert(bytes("daily cap"));t.withdraw(address(v),151e6,type(uint256).max,keccak256("too much"));vm.prank(owner);t.disengage();vm.prank(agent);vm.expectRevert(bytes("inactive"));t.withdraw(address(v),1e6,type(uint256).max,keccak256("paused"));vm.prank(owner);t.withdraw(address(v),150e6,type(uint256).max,keccak256("owner recovery"));require(token.balanceOf(address(t))==1000e6,"recovery failed");}
 function testPassportSignedJobFeedbackAndDuplicate() public {AgentPassport p=new AgentPassport();vm.prank(owner);uint256 id=p.register("data:application/json,{}");bytes32 job=keccak256("job1");vm.prank(owner);p.recordJob(id,job,client);uint256 deadline=block.timestamp+300;bytes memory sig=signature(CLIENT_KEY,p.feedbackDigest(id,job,92,"ipfs://evidence",deadline));p.giveFeedback(id,job,92,"ipfs://evidence",deadline,sig);vm.expectRevert(bytes("duplicate"));p.giveFeedback(id,job,92,"ipfs://evidence",deadline,sig);vm.prank(validator);p.attest(id,job,100,keccak256("validated"));}
 function testPassportForgedAndSelfFeedbackRejected() public {AgentPassport p=new AgentPassport();vm.prank(owner);uint256 id=p.register("data:application/json,{}");bytes32 job=keccak256("job1");vm.prank(owner);vm.expectRevert(bytes("invalid job"));p.recordJob(id,job,owner);vm.prank(owner);p.recordJob(id,job,client);uint256 deadline=block.timestamp+300;bytes memory sig=signature(AGENT_KEY,p.feedbackDigest(id,job,100,"ipfs://evidence",deadline));vm.expectRevert(bytes("bad signature"));p.giveFeedback(id,job,100,"ipfs://evidence",deadline,sig);}
 function testFuzzSessionNeverExceedsCap(uint96 amount) public {SessionVault v=session();uint256 a=uint256(amount)%50000000+1;uint256 deadline=block.timestamp+300;bytes32 d=v.digest(address(token),client,a,deadline,false,bytes32(uint256(1)));bytes memory sig=signature(AGENT_KEY,d);bytes memory cosign=signature(OWNER_KEY,d);if(a>25e6)vm.expectRevert(bytes("daily cap"));v.transfer(address(token),client,a,deadline,false,bytes32(uint256(1)),sig,cosign);require(token.balanceOf(client)<=25e6,"cap escaped");}
}
