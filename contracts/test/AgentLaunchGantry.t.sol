pragma solidity ^0.8.24;
import {AgentLaunchGantry,LaunchAgent,GantryBuyerVault} from "../src/AgentLaunchGantry.sol";
import {MockUSDC,Vm} from "./Agents.t.sol";
contract GantryTest {
 Vm vm=Vm(address(uint160(uint256(keccak256("hevm cheat code")))));MockUSDC money;AgentLaunchGantry factory;LaunchAgent agent;address alice=address(0x1234);address bob=address(0x2345);
 function setUp() public {money=new MockUSDC();factory=new AgentLaunchGantry(address(money));agent=LaunchAgent(factory.launch("Copper Oracle","COPR","Explain crypto","Explain risk honestly",1e6));money.mint(alice,100_000e6);money.mint(bob,100_000e6);vm.prank(alice);money.approve(address(agent),type(uint256).max);vm.prank(bob);money.approve(address(agent),type(uint256).max);}
 function buy(address wallet,uint256 amount) internal {uint256 quote=agent.quoteBuy(amount);vm.prank(wallet);agent.buy(amount,quote,block.timestamp);}
 function testAtomicLaunchFixedSupplyAndNoAdmin() public {require(factory.count()==1&&agent.totalSupply()==1_000_000e18&&agent.owner()==address(0),"launch");vm.expectRevert();agent.mintTo(alice,1);vm.expectRevert();agent.setOwner(alice);vm.expectRevert();agent.burn(1);}
 function testBuySellAndSlippage() public {buy(alice,10e6);uint256 tokens=agent.balanceOf(alice);uint256 out=agent.quoteSell(tokens);require(out<=10e6,"roundtrip gain");vm.prank(alice);agent.sell(tokens,out,block.timestamp);require(agent.balanceOf(alice)==0&&agent.reserve()==10e6-out,"reserve");vm.prank(alice);vm.expectRevert();agent.buy(1e6,type(uint256).max,block.timestamp);vm.prank(alice);vm.expectRevert();agent.buy(1e6,0,block.timestamp-1);}
 function testRevenueTransferCorrectionAndClaim() public {buy(alice,10e6);vm.prank(bob);agent.tip(4e6);uint256 earned=agent.claimable(alice);require(earned>=3999999,"earned");uint256 held=agent.balanceOf(alice);vm.prank(alice);agent.transfer(bob,held);require(agent.claimable(alice)==earned&&agent.claimable(bob)==0,"stolen past dividends");vm.prank(alice);agent.tip(2e6);require(agent.claimable(bob)>=1999999,"new holder");vm.prank(alice);agent.claim();vm.prank(bob);agent.claim();require(agent.distributed()<=agent.revenue()&&money.balanceOf(address(agent))>=agent.reserve(),"insolvency");vm.prank(alice);vm.expectRevert();agent.claim();}
 function testServicePaymentsBoundAndReplay() public {buy(alice,1e6);vm.prank(bob);agent.payService(keccak256("job"),keccak256("request"));require(agent.paidBy(keccak256("job"))==bob&&agent.revenue()==1e6,"paid");vm.prank(bob);vm.expectRevert();agent.payService(keccak256("job"),keccak256("other"));}
 function testCreatorCliffLinearVesting() public {vm.expectRevert();agent.releaseCreator();vm.warp(block.timestamp+90 days);agent.releaseCreator();require(agent.balanceOf(address(this))==uint256(200_000e18)*90/365,"cliff");vm.warp(block.timestamp+365 days);agent.releaseCreator();require(agent.creatorReleased()==200_000e18,"vesting");}
 function testRevenueExcludedInventoryAndReserveProtected() public {vm.prank(bob);vm.expectRevert();agent.tip(1e6);buy(alice,10e6);vm.prank(bob);agent.tip(1e6);vm.prank(alice);agent.claim();require(money.balanceOf(address(agent))>=agent.reserve(),"curve drained by dividends");}
 function testFuzzConservation(uint96 raw) public {uint256 amount=uint256(raw)%100_000e6+1;buy(alice,amount);uint256 tokens=agent.balanceOf(alice);uint256 out=agent.quoteSell(tokens);require(out<=amount,"profit from rounding");if(out>0){vm.prank(alice);agent.sell(tokens,out,block.timestamp);require(money.balanceOf(address(agent))>=agent.reserve(),"reserve conservation");}}
}

contract GantryBuyerVaultTest {
 Vm vm=Vm(address(uint160(uint256(keccak256("hevm cheat code")))));MockUSDC money;AgentLaunchGantry factory;LaunchAgent listing;GantryBuyerVault vault;address signer=address(0x7777);
 function setUp() public {money=new MockUSDC();factory=new AgentLaunchGantry(address(money));listing=LaunchAgent(factory.launch("Agent","AGT","Text service","Explain clearly",1e6));vault=new GantryBuyerVault(address(this),signer,address(money),address(factory));money.mint(address(vault),20e6);}
 function grant() internal {uint256[] memory ids=new uint256[](1);ids[0]=0;vault.grant(ids,5e6,5e6,block.timestamp+1 days);}
 function testOnchainCapsPauseAndRenewCannotResetDailySpent() public {grant();vm.prank(signer);vault.buy(0,5e6,0,block.timestamp);require(vault.spent(block.timestamp/1 days)==5e6&&listing.balanceOf(address(vault))>0,"purchase");grant();vm.prank(signer);vm.expectRevert(bytes("vault budget"));vault.buy(0,1,0,block.timestamp);vault.revoke();vm.prank(signer);vm.expectRevert(bytes("vault authority"));vault.buy(0,1,0,block.timestamp);}
 function testOnchainAllowlistExpiryAndRecoveryAuthority() public {grant();vm.prank(signer);vm.expectRevert(bytes("vault authority"));vault.buy(1,1,0,block.timestamp);vm.prank(signer);vm.expectRevert(bytes("owner only"));vault.recover(address(money),1);vm.warp(block.timestamp+1 days);vm.prank(signer);vm.expectRevert(bytes("vault authority"));vault.buy(0,1,0,block.timestamp);vault.recover(address(money),20e6);require(money.balanceOf(address(this))==20e6,"recover");}
}
