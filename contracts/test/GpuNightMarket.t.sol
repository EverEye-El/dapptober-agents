pragma solidity ^0.8.24;
import {GpuNightMarket} from "../src/GpuNightMarket.sol";
import {MockUSDC,Vm} from "./Agents.t.sol";
contract GpuNightMarketTest {
 Vm vm=Vm(address(uint160(uint256(keccak256("hevm cheat code")))));MockUSDC token;GpuNightMarket market;address provider=address(0x1234);address buyer=address(0x2345);address agent=address(0x3456);
 function setUp() public {token=new MockUSDC();market=new GpuNightMarket(address(this),address(token));vm.prank(provider);market.list("qwen3:0.6b",24,2,30000,true);token.mint(buyer,100e6);token.mint(agent,100e6);vm.prank(buyer);token.approve(address(market),type(uint256).max);vm.prank(agent);token.approve(address(market),type(uint256).max);market.allowProvider(provider,true);market.setAgent(agent,60000,90000,block.timestamp+1 days,false);}
 function book(address who,bytes32 request) internal returns(uint256 id){vm.prank(who);return market.book(provider,1,keccak256("input"),30000,request);}
 function testEscrowDeliveryAndDuplicateRejection() public {uint256 id=book(buyer,keccak256("one"));require(token.balanceOf(address(market))==30000,"not escrowed");vm.prank(buyer);vm.expectRevert(bytes("not deliverable"));market.deliver(id,keccak256("output"));vm.prank(provider);market.deliver(id,keccak256("output"));require(token.balanceOf(provider)==30000,"not paid");require(token.balanceOf(address(market))==0,"liability remains");vm.prank(provider);vm.expectRevert(bytes("not deliverable"));market.deliver(id,keccak256("output"));}
 function testTimeoutRefundFreesCapacity() public {uint256 id=book(buyer,keccak256("one"));vm.expectRevert(bytes("not refundable"));market.refund(id);vm.warp(block.timestamp+361);vm.prank(provider);vm.expectRevert(bytes("not deliverable"));market.deliver(id,keccak256("output"));market.refund(id);require(token.balanceOf(buyer)==100e6,"refund wrong");(,,,uint32 active,,,,uint256 failed)=market.stalls(provider);require(active==0&&failed==1,"metrics wrong");vm.expectRevert(bytes("not refundable"));market.refund(id);}
 function testCapacityPriceAndReplayChecks() public {book(buyer,keccak256("one"));vm.prank(buyer);vm.expectRevert(bytes("request replay"));market.book(provider,1,keccak256("input"),30000,keccak256("one"));book(buyer,keccak256("two"));vm.prank(buyer);vm.expectRevert(bytes("provider unavailable"));market.book(provider,1,keccak256("input"),30000,keccak256("three"));vm.prank(provider);vm.expectRevert(bytes("capacity in use"));market.list("qwen3:0.6b",24,1,30000,true);}
 function testPriceAndSelfDealing() public {vm.prank(buyer);vm.expectRevert(bytes("price moved"));market.book(provider,2,keccak256("input"),30000,keccak256("one"));vm.prank(provider);vm.expectRevert(bytes("self dealing"));market.book(provider,1,keccak256("input"),30000,keccak256("one"));}
 function testAgentDailyCapsCannotBeResetByRenewal() public {uint256 a=book(agent,keccak256("one"));vm.prank(provider);market.deliver(a,keccak256("out"));a=book(agent,keccak256("two"));vm.prank(provider);market.deliver(a,keccak256("out"));a=book(agent,keccak256("three"));vm.prank(provider);market.deliver(a,keccak256("out"));market.setAgent(agent,60000,90000,block.timestamp+2 days,false);vm.prank(agent);vm.expectRevert(bytes("agent budget"));market.book(provider,1,keccak256("input"),30000,keccak256("four"));}
 function testAgentPermissionsExpiryAndPause() public {market.allowProvider(provider,false);vm.prank(agent);vm.expectRevert(bytes("provider not approved"));market.book(provider,1,keccak256("input"),30000,keccak256("one"));market.allowProvider(provider,true);market.setAgent(agent,60000,90000,block.timestamp,true);vm.prank(agent);vm.expectRevert(bytes("agent stopped"));market.book(provider,1,keccak256("input"),30000,keccak256("one"));}
 function testPausePreservesDeliveryAndRefund() public {uint256 id=book(buyer,keccak256("one"));market.setPaused(true);vm.prank(buyer);vm.expectRevert(bytes("market paused"));market.book(provider,1,keccak256("input"),30000,keccak256("two"));vm.prank(provider);market.deliver(id,keccak256("output"));require(token.balanceOf(provider)==30000,"delivery blocked");}
 function testFuzzEscrowConservation(uint8 input) public {uint256 minutesReserved=uint256(input)%60+1;uint256 amount=minutesReserved*30000;vm.prank(buyer);uint256 id=market.book(provider,minutesReserved,keccak256("input"),amount,keccak256("one"));require(token.balanceOf(address(market))==amount,"escrow mismatch");vm.prank(provider);market.deliver(id,keccak256("output"));require(token.balanceOf(buyer)+token.balanceOf(provider)==100e6,"funds lost");}
}
