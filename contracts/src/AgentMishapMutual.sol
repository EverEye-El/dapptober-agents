pragma solidity ^0.8.24;
import {IERC20} from '@openzeppelin/contracts/token/ERC20/IERC20.sol';
import {SafeERC20} from '@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol';
import {ReentrancyGuard} from '@openzeppelin/contracts/utils/ReentrancyGuard.sol';
import {Checkpoints} from '@openzeppelin/contracts/utils/structs/Checkpoints.sol';
import {Math} from '@openzeppelin/contracts/utils/math/Math.sol';
interface IMutualIdentity {function ownerOf(uint256) external view returns(address);function getAgentWallet(uint256) external view returns(address);}
interface IMutualReputation {function getIdentityRegistry() external view returns(address);function getSummary(uint256,address[] calldata,string calldata,string calldata) external view returns(uint64,int128,uint8);}
/// @notice Finite-season, fully reserved USDC mutual. Premiums belong to risk-bearing members; no guaranteed yield.
contract AgentMishapMutual is ReentrancyGuard {
 using SafeERC20 for IERC20;using Checkpoints for Checkpoints.Trace208;
 IERC20 public immutable usdc;IMutualIdentity public immutable identity;IMutualReputation public immutable reputation;address public immutable guardian;uint256 public immutable underwritingCloses;
 bytes32 public constant VERSION=keccak256('UMBRA_MUTUAL_V1');uint256 public constant WAIT=1 hours;uint256 public constant TERM=7 days;uint256 public constant GRACE=3 days;uint256 public constant VOTE=3 days;
 bool public paused;uint256 public totalShares;uint256 public reserved;uint256 public creditsTotal;uint256 public coverCount;uint256 public claimCount;uint256 public lastCapitalChangeBlock;
 address[] public trustedReviewers;mapping(address=>uint256) public shares;mapping(address=>uint256) public credits;mapping(uint256=>uint256) public paidHistory;mapping(bytes32=>bool) public incidents;
 Checkpoints.Trace208 private totalHistory;mapping(address=>Checkpoints.Trace208) private shareHistory;
 struct Cover {address owner;address agentWallet;uint256 agentId;uint256 limit;uint256 premium;uint256 start;uint256 end;uint48 snapshot;uint256 electorate;bool closed;uint256 claimId;}
 struct Claim {uint256 coverId;uint256 amount;uint256 incidentAt;bytes32 incident;bytes32 evidenceHash;string evidenceURI;uint256 votingEnds;uint256 yes;uint256 no;uint8 status;}
 mapping(uint256=>Cover) public covers;mapping(uint256=>Claim) public claims;mapping(uint256=>mapping(address=>bool)) public voted;
 event Capital(address indexed member,uint256 assets,uint256 shares,bool deposit);event Covered(uint256 indexed id,address indexed owner,uint256 indexed agentId,uint256 limit,uint256 premium,uint48 snapshot);event Filed(uint256 indexed id,uint256 indexed coverId,bytes32 incident,bytes32 evidenceHash,string evidenceURI);event Ballot(uint256 indexed id,address indexed member,bool support,uint256 weight);event Resolved(uint256 indexed id,bool approved,uint256 amount);event Paid(address indexed member,uint256 amount);
 constructor(address token,address idRegistry,address repRegistry,address guard,address[] memory reviewers){require(block.chainid==8453||block.chainid==84532||block.chainid==31337,'network');if(block.chainid==8453)require(token==0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913,'USDC');if(block.chainid==84532)require(token==0x036CbD53842c5426634e7929541eC2318f3dCF7e,'USDC');require(token.code.length>0&&idRegistry.code.length>0&&repRegistry.code.length>0&&guard!=address(0),'config');require(reviewers.length>0&&reviewers.length<=16,'reviewers');for(uint i;i<reviewers.length;i++){require(reviewers[i]!=address(0),'reviewer');for(uint j;j<i;j++)require(reviewers[i]!=reviewers[j],'duplicate');}require(IMutualReputation(repRegistry).getIdentityRegistry()==idRegistry,'registry pair');usdc=IERC20(token);identity=IMutualIdentity(idRegistry);reputation=IMutualReputation(repRegistry);guardian=guard;trustedReviewers=reviewers;underwritingCloses=block.timestamp+7 days;}
 function assets() public view returns(uint256){return usdc.balanceOf(address(this))-creditsTotal;}
 function freeCapital() public view returns(uint256){return assets()-reserved;}
 function checkpoint(address user) private {lastCapitalChangeBlock=block.number;require(totalShares<=type(uint208).max&&shares[user]<=type(uint208).max,'share bound');totalHistory.push(uint48(block.number),uint208(totalShares));shareHistory[user].push(uint48(block.number),uint208(shares[user]));}
 function weightAt(address user,uint48 atBlock) public view returns(uint256){require(atBlock<block.number,'past block');return shareHistory[user].upperLookupRecent(atBlock);}
 function deposit(uint256 amount,uint256 minShares) external nonReentrant {require(!paused&&block.timestamp<underwritingCloses&&amount>=10e6&&amount<=10000e6,'deposit');uint256 minted=Math.mulDiv(amount,totalShares+1,assets()+1);require(minted>0&&minted>=minShares,'slippage');usdc.safeTransferFrom(msg.sender,address(this),amount);shares[msg.sender]+=minted;totalShares+=minted;checkpoint(msg.sender);emit Capital(msg.sender,amount,minted,true);}
 function withdraw(uint256 amountShares,uint256 minAssets) external nonReentrant {require(reserved==0,'capital backs cover');require(amountShares>0&&amountShares<=shares[msg.sender],'shares');uint256 amount=Math.mulDiv(amountShares,assets()+1,totalShares+1);require(amount>=minAssets&&amount>0,'slippage');shares[msg.sender]-=amountShares;totalShares-=amountShares;checkpoint(msg.sender);usdc.safeTransfer(msg.sender,amount);emit Capital(msg.sender,amount,amountShares,false);}
 function quote(uint256 agentId,uint256 limit) public view returns(uint256 premium,uint256 score,uint256 rate){require(limit>=10e6&&limit<=1000e6,'limit');(uint64 count,int128 value,uint8 decimals)=reputation.getSummary(agentId,trustedReviewers,'quality','');require(decimals<=18,'decimals');if(count>=3&&value>0)score=Math.min(uint256(uint128(value))/(10**decimals),100);rate=Math.min(1000,1000-score*8+Math.min(paidHistory[agentId],8)*100);premium=Math.mulDiv(limit,rate,10000,Math.Rounding.Ceil);}
 function buy(uint256 agentId,uint256 limit,uint256 maxPremium) external nonReentrant returns(uint256 id){require(!paused&&block.timestamp<underwritingCloses&&coverCount<200,'underwriting closed');require(identity.ownerOf(agentId)==msg.sender,'agent owner');require(block.number>lastCapitalChangeBlock,'capital block');address agentWallet=identity.getAgentWallet(agentId);require(agentWallet!=address(0),'agent wallet');(uint256 premium,,)=quote(agentId,limit);require(premium<=maxPremium&&limit<=freeCapital(),'price/capital');uint48 snap=uint48(block.number-1);uint256 electorate=totalHistory.upperLookupRecent(snap)-shareHistory[msg.sender].upperLookupRecent(snap);require(electorate>=10e6,'independent members');usdc.safeTransferFrom(msg.sender,address(this),premium);reserved+=limit;id=++coverCount;covers[id]=Cover(msg.sender,agentWallet,agentId,limit,premium,block.timestamp+WAIT,block.timestamp+TERM,snap,electorate,false,0);emit Covered(id,msg.sender,agentId,limit,premium,snap);}
 function file(uint256 coverId,uint256 amount,uint256 incidentAt,bytes32 incident,bytes32 evidenceHash,string calldata uri) external returns(uint256 id){Cover storage c=covers[coverId];require(c.owner==msg.sender&&!c.closed&&c.claimId==0,'policy');require(block.timestamp<=c.end+GRACE&&incidentAt>=c.start&&incidentAt<=c.end&&incidentAt<=block.timestamp,'incident window');require(amount>0&&amount<=c.limit&&incident!=bytes32(0)&&evidenceHash!=bytes32(0)&&bytes(uri).length>0&&bytes(uri).length<=512,'evidence/amount');require(!incidents[incident],'duplicate incident');id=++claimCount;c.claimId=id;claims[id]=Claim(coverId,amount,incidentAt,incident,evidenceHash,uri,block.timestamp+VOTE,0,0,1);emit Filed(id,coverId,incident,evidenceHash,uri);}
 function vote(uint256 id,bool support) external {Claim storage claim=claims[id];Cover storage c=covers[claim.coverId];require(claim.status==1&&block.timestamp<claim.votingEnds&&!voted[id][msg.sender]&&msg.sender!=c.owner,'ballot');uint256 weight=weightAt(msg.sender,c.snapshot);require(weight>0,'snapshot member');voted[id][msg.sender]=true;if(support)claim.yes+=weight;else claim.no+=weight;emit Ballot(id,msg.sender,support,weight);}
 function settle(uint256 id) external {Claim storage claim=claims[id];require(claim.status==1&&block.timestamp>=claim.votingEnds,'voting');Cover storage c=covers[claim.coverId];bool approved=(claim.yes+claim.no)*100>=c.electorate*30&&claim.yes>claim.no&&!incidents[claim.incident];claim.status=approved?2:3;c.closed=true;reserved-=c.limit;if(approved){incidents[claim.incident]=true;credits[c.owner]+=claim.amount;creditsTotal+=claim.amount;paidHistory[c.agentId]++;}emit Resolved(id,approved,approved?claim.amount:0);}
 function expire(uint256 id) external {Cover storage c=covers[id];require(c.owner!=address(0)&&!c.closed&&c.claimId==0&&block.timestamp>c.end+GRACE,'live policy');c.closed=true;reserved-=c.limit;}
 function claimPayout() external nonReentrant {uint256 amount=credits[msg.sender];require(amount>0,'no credit');credits[msg.sender]=0;creditsTotal-=amount;usdc.safeTransfer(msg.sender,amount);emit Paid(msg.sender,amount);}
 function setPaused(bool value) external {require(msg.sender==guardian,'guardian');paused=value;}
}
