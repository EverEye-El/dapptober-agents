pragma solidity ^0.8.25;
import {IERC20} from '@openzeppelin/contracts/token/ERC20/IERC20.sol';
import {IERC4626} from '@openzeppelin/contracts/interfaces/IERC4626.sol';
import {SafeERC20} from '@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol';
import {EIP712} from '@openzeppelin/contracts/utils/cryptography/EIP712.sol';
import {SignatureChecker} from '@openzeppelin/contracts/utils/cryptography/SignatureChecker.sol';
import {ReentrancyGuard} from '@openzeppelin/contracts/utils/ReentrancyGuard.sol';
interface IRefereeValidation {function getValidationStatus(bytes32) external view returns(address,uint256,uint8,bytes32,string memory,uint256);function validationResponse(bytes32,uint8,string calldata,bytes32,string calldata) external;}
/// Base-native ERC4626 collateral security. This is NOT Ethereum EigenLayer restaking/slashing.
contract RestakedReferee is EIP712,ReentrancyGuard {
 using SafeERC20 for IERC20;
 bytes32 public constant VERSION=keccak256('OVERRULE_V1');
 bytes32 public constant VERDICT_TYPEHASH=keccak256('Verdict(bytes32 taskId,address operator,bool passed,bytes32 evidenceHash,uint256 deadline)');
 IERC20 public immutable usdc;IERC4626 public immutable vault;address public immutable guardian;IRefereeValidation public immutable registry;uint256 public immutable reviewWindow;bool public paused;
 struct Operator {uint256 shares;uint256 locked;uint256 reports;uint256 slashes;}
 struct Task {address creator;uint256 agentId;uint8 kind;int256 claimed;int256 expected;bytes32 inputHash;}
 struct Report {bytes32 taskId;address operator;bool passed;bytes32 evidenceHash;uint256 shares;uint256 reviewEnd;uint8 status;}
 mapping(address=>Operator) public operators;mapping(bytes32=>Task) public tasks;mapping(bytes32=>Report) public reports;bytes32[] public taskIds;bytes32[] public reportIds;
 event Registered(address indexed operator,uint256 assets,uint256 shares);event TaskOpened(bytes32 indexed id,uint256 agentId,uint8 kind,int64[] inputs,int256 claimed);
 event VerdictSigned(bytes32 indexed id,bytes32 indexed taskId,address indexed operator,bool passed,bytes32 evidenceHash,uint256 deadline,uint256 reviewEnd,bytes signature);event Challenged(bytes32 indexed id,address challenger,bytes32 proofHash);event Settled(bytes32 indexed id,bool slashed,uint256 shares,address recipient);
 constructor(address token,address receiptVault,address validationRegistry,uint256 window) EIP712('Overrule','1') {require(window>=60&&window<=7 days,'window');if(block.chainid==8453||block.chainid==84532){require(window>=1 hours,'live window');require(token==(block.chainid==8453?address(0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913):address(0x036CbD53842c5426634e7929541eC2318f3dCF7e)),'Circle USDC');}else require(block.chainid==31337,'chain');usdc=IERC20(token);vault=IERC4626(receiptVault);require(vault.asset()==token,'vault asset');registry=IRefereeValidation(validationRegistry);guardian=msg.sender;reviewWindow=window;}
 function pause(bool value) external {require(msg.sender==guardian,'guardian');paused=value;}
 function register(uint256 assets,uint256 minShares) external nonReentrant {require(!paused&&assets>=10e6&&assets<=1000e6,'deposit bound');uint256 beforeBalance=usdc.balanceOf(address(this));usdc.safeTransferFrom(msg.sender,address(this),assets);require(usdc.balanceOf(address(this))-beforeBalance==assets,'exact token');usdc.forceApprove(address(vault),assets);uint256 shares=vault.deposit(assets,address(this));usdc.forceApprove(address(vault),0);require(shares>=minShares&&shares>0,'shares');operators[msg.sender].shares+=shares;emit Registered(msg.sender,assets,shares);}
 function withdraw(uint256 shares) external nonReentrant {Operator storage o=operators[msg.sender];require(shares>0&&shares<=o.shares-o.locked,'locked collateral');o.shares-=shares;IERC20(address(vault)).safeTransfer(msg.sender,shares);}
 function rerun(uint8 kind,int64[] memory inputs) public pure returns(int256 result){require(kind<=1&&inputs.length>0&&inputs.length<=32,'unsupported task');result=kind==0?int256(0):int256(inputs[0]);for(uint256 i=0;i<inputs.length;i++){if(kind==0)result+=inputs[i];else if(inputs[i]>result)result=inputs[i];}}
 function createTask(uint256 agentId,uint8 kind,int64[] calldata inputs,int256 claimed,bytes32 salt) external returns(bytes32 id){require(!paused,'paused');int256 expected=rerun(kind,inputs);id=keccak256(abi.encode(msg.sender,agentId,kind,inputs,claimed,salt));require(tasks[id].creator==address(0),'duplicate task');if(address(registry)!=address(0)){(address validator,uint256 registeredId,,,,)=registry.getValidationStatus(id);require(validator==address(this)&&registeredId==agentId,'registry request');}tasks[id]=Task(msg.sender,agentId,kind,claimed,expected,keccak256(abi.encode(inputs)));taskIds.push(id);emit TaskOpened(id,agentId,kind,inputs,claimed);}
 function verdictDigest(bytes32 taskId,address operator,bool passed,bytes32 evidenceHash,uint256 deadline) public view returns(bytes32){return _hashTypedDataV4(keccak256(abi.encode(VERDICT_TYPEHASH,taskId,operator,passed,evidenceHash,deadline)));}
 function submitVerdict(bytes32 taskId,address operator,bool passed,bytes32 evidenceHash,uint256 deadline,bytes calldata signature) external returns(bytes32 id){require(!paused&&tasks[taskId].creator!=address(0),'task/paused');require(deadline>=block.timestamp&&deadline<=block.timestamp+300&&evidenceHash!=bytes32(0),'expiry/evidence');require(SignatureChecker.isValidSignatureNow(operator,verdictDigest(taskId,operator,passed,evidenceHash,deadline),signature),'signature');id=keccak256(abi.encode(taskId,operator));require(reports[id].operator==address(0),'duplicate verdict');Operator storage o=operators[operator];uint256 risk=vault.previewWithdraw(10e6);require(risk>0&&risk<=o.shares-o.locked,'collateral');o.locked+=risk;o.reports++;uint256 end=block.timestamp+reviewWindow;reports[id]=Report(taskId,operator,passed,evidenceHash,risk,end,1);reportIds.push(id);emit VerdictSigned(id,taskId,operator,passed,evidenceHash,deadline,end,signature);}
 function truth(bytes32 taskId) public view returns(bool){Task storage t=tasks[taskId];require(t.creator!=address(0),'task');return t.claimed==t.expected;}
 function challenge(bytes32 id) external {Report storage r=reports[id];require(r.status==1&&block.timestamp<r.reviewEnd,'review closed');require(r.passed!=truth(r.taskId),'honest verdict');r.status=2;emit Challenged(id,msg.sender,keccak256(abi.encode(r.taskId,r.passed,truth(r.taskId),r.evidenceHash)));}
 function settle(bytes32 id) external nonReentrant {Report storage r=reports[id];require((r.status==1||r.status==2)&&block.timestamp>=r.reviewEnd,'review active/settled');Operator storage o=operators[r.operator];o.locked-=r.shares;bool slash=r.passed!=truth(r.taskId);if(slash){r.status=4;o.shares-=r.shares;o.slashes++;IERC20(address(vault)).safeTransfer(tasks[r.taskId].creator,r.shares);}else r.status=3;emit Settled(id,slash,r.shares,slash?tasks[r.taskId].creator:r.operator);}
 function publishValidation(bytes32 id,string calldata uri) external {Report storage r=reports[id];require(address(registry)!=address(0)&&(r.status==3||r.status==4),'final/registry');require(bytes(uri).length<=500,'uri');registry.validationResponse(r.taskId,truth(r.taskId)?100:0,uri,keccak256(abi.encode(id,r.evidenceHash,r.status)),'overrule-final');}
 function counts() external view returns(uint256,uint256){return(taskIds.length,reportIds.length);}
}
