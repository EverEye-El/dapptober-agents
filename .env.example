# Dapptober Days 01–10 — complete configuration reference
# Apps read their own apps/agents/day-*/.env.local, NOT a root .env.local.
# Use each daily .env.example as your copy-ready template; it includes only that day’s inputs and correct port.
# Fill empty credentials/addresses privately. Known network/model/token settings are already provided.
# See docs/PROJECT-COMPLETION-TRACKER.md for deployment, funding and protocol requirements.
# Switch AGENT_MODE to real only after that day is configured. API keys alone do not deploy contracts.

AGENT_MODE=demo

CHAIN_ID=84532

# Local origin: use port 3001 through 3010 for the matching day; hosted apps use their own HTTPS origin.
PUBLIC_ORIGIN=http://localhost:3001

# REQUIRED for real mode: paste the full private database URI from Supabase → Connect → Session pooler. Not a project URL or API key. Use separate testing/production projects.
DATABASE_URL=

# REQUIRED for real mode: generate a unique 32+ character random secret for this app. Enter it in the control room; Day 10 uses it for administration only.
OPERATOR_TOKEN=

# REQUIRED: your owner wallet public address (0x + 40 hex characters). Never put its private key here.
OWNER_ADDRESS=

# READY for Base Sepolia testing. Replace with your dedicated Base RPC for production, together with CHAIN_ID=8453 and production contract/token addresses.
RPC_URL=https://sepolia.base.org

# DAY-SPECIFIC server signer: dedicated 0x-prefixed 64-hex private key, never the owner wallet key. Days 01/02/04/05/09 need agent signing; Day 08 uses it as delegate seed; Day 10 as reward voucher verifier.
AGENT_PRIVATE_KEY=

# REQUIRED for real mode: TypeSafe/Jev API key with jev-latest access. Screening endpoint is fixed in code: https://api.typesafe.ai/v1/systemone.
TYPESAFE_API_KEY=

# REQUIRED for live reasoning: your OpenAI server API key (billing/model access enabled). No OpenAI key is used by Day 07.
AI_API_KEY=

# READY: OpenAI-compatible inference endpoint; change only when using another compatible provider.
AI_BASE_URL=https://api.openai.com/v1

# READY: model used when Jev selects small reasoning.
AI_SMALL_MODEL=gpt-4.1-mini

# READY: model used when Jev selects large reasoning.
AI_LARGE_MODEL=gpt-4.1

# DAY 01 REQUIRED: thirdweb project server secret key, not public client ID. Enable the account-abstraction gas sponsorship used by this app.
THIRDWEB_SECRET_KEY=

# DAY 01 REQUIRED AFTER DEPLOYMENT: SessionVault contract address on Base Sepolia, deployed with OWNER_ADDRESS.
SESSION_VAULT=

# READY: Circle USDC on Base Sepolia. Base production: 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913.
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# DAY 02 REQUIRED: public wallet address receiving the USDC toll. You may choose your OWNER_ADDRESS.
PAY_TO=

# READY: existing x402 facilitator default. Verify actual Base Sepolia/Base support before live use; a provider requiring authentication needs the documented adapter work.
FACILITATOR_URL=https://x402.org/facilitator

# READY: charge 0.01 USDC per paid request.
TOLL_USDC=0.01

# READY: payer daily budget in USDC.
TOLL_DAILY_BUDGET=1

# DAY 03 REQUIRED AFTER DEPLOYMENT: this project’s AgentPassport address. This is not Day 10’s ERC-8004 registry.
PASSPORT_REGISTRY=

# DAY 03 OPTIONAL: verified EAS contract address on the chosen network. Leave blank if not enabling EAS.
EAS_ADDRESS=

# DAY 03 OPTIONAL: registered EAS schema UID (0x + 64 hex) for bytes32 job, bytes32 evidence, uint8 score.
EAS_SCHEMA=

# DAY 04 REQUIRED AFTER DEPLOYMENT: QuestEscrow address configured with this network’s USDC.
QUEST_ESCROW=

# DAY 05 REQUIRED AFTER DEPLOYMENT: FlightTreasury address configured with OWNER_ADDRESS and this network’s USDC.
FLIGHT_TREASURY=

# DAY 05 REQUIRED for live monitoring: JSON array of distinct verified USDC ERC4626 lending and savings vaults. No verified public vault addresses have been supplied. Shape: [{"address":"<deployed address>","name":"Lending","kind":"lending","risk":1},{"address":"<deployed address>","name":"Savings","kind":"savings","risk":0}].
VAULT_CONFIG=[]

# DAY 06 READY: must equal CHAIN_ID. Base Sepolia has no official CoW solver endpoint; live operations remain blocked. Production uses 8453.
COW_CHAIN_ID=84532

# DAY 06 READY: Circle Base Sepolia USDC. Production must use the Base mainnet USDC address. This value does not provision a testnet solver.
COW_USDC=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# DAY 06 REQUIRED for supported live CoW deployment: verified WETH token address on the same network. Base Sepolia solver availability remains unresolved.
COW_WETH=

# DAY 07 REQUIRED: your HTTPS worker URL inside a Phala/dstack Intel TDX CVM. This requires worker deployment, not just an API key.
TEE_WORKER_URL=

# DAY 07 REQUIRED: generate a random 32+ character secret and set the same token on the confidential worker.
TEE_WORKER_TOKEN=

# DAY 07 READY: Ollama model name. Pin the matching manifest digest below.
TEE_MODEL=qwen3:0.6b

# DAY 07 REQUIRED AFTER WORKER SETUP: exact Ollama manifest SHA256, 0x-prefixed 64 lowercase hex characters.
TEE_MODEL_DIGEST=

# DAY 07 REQUIRED AFTER ATTESTATION REVIEW: JSON keys mrtd, rtmr0, rtmr1, rtmr2, rtmr3, each 96 lowercase hex characters. Obtain from the reviewed immutable worker; never invent measurements.
TEE_MEASUREMENTS={}

# DAY 07 OPTIONAL AFTER DEPLOYMENT: InferenceAnchor address for owner-wallet publication. Leave blank for inference without onchain anchoring.
INFERENCE_ANCHOR=

# DAY 08 REQUIRED AFTER DEPLOYMENT: SenateVoice address on the same network as the governor.
SENATE_TOKEN=

# DAY 08 REQUIRED AFTER DEPLOYMENT: SwarmGovernor address configured with SENATE_TOKEN.
SENATE_GOVERNOR=

# DAY 08 REQUIRED AFTER DEPLOYMENT: decimal block number from the governor deployment receipt, not an arbitrary zero.
SENATE_START_BLOCK=

# DAY 09 REQUIRED AFTER DEPLOYMENT: ForecastColosseum address configured with owner, USDC and verified UMA oracle.
FORECAST_MARKET=

# DAY 09 REQUIRED: verified UMA Optimistic Oracle v3 address for this network; also verify currency whitelist, ASSERT_TRUTH2 and minimum bond. See completion tracker.
UMA_ORACLE=

# DAY 10 REQUIRED: production World Developer Portal app identifier beginning app_.
WORLD_APP_ID=

# DAY 10 REQUIRED: World relying-party identifier beginning rp_.
WORLD_RP_ID=

# DAY 10 REQUIRED: private World RP signing key (0x + 64 hex); server-only.
WORLD_SIGNING_KEY=

# DAY 10 READY: fixed action for this reward campaign. Do not change after enrolling people.
WORLD_ACTION=dapptober-human-checkpoint-2026

# DAY 10 REQUIRED: generate a stable 32+ character random secret for visitor session cookies. Keep it across restarts.
CHECKPOINT_SESSION_SECRET=

# DAY 10 REQUIRED: verified actual ERC-8004 IdentityRegistry address on the chosen Base network, not the Day 03 passport.
CHECKPOINT_REGISTRY=

# DAY 10 REQUIRED AFTER DEPLOYMENT: HumanCheckpointRewards address. Its verifier must match AGENT_PRIVATE_KEY; campaign and USDC must match configuration.
CHECKPOINT_REWARDS=
