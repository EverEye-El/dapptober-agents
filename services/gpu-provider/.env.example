# Private provider worker settings; load with node --env-file=.env.local server.mjs.
# Use the same network and market contract as the Day 11 app.
CHAIN_ID=84532
RPC_URL=https://sepolia.base.org
# Actual deployed GpuNightMarket address.
GPU_MARKET=
# Dedicated provider wallet signer (0x + 64 hex); receives jobs' USDC and pays delivery gas.
GPU_PROVIDER_PRIVATE_KEY=
# Generate 32+ random characters; put this same token in the matching GPU_PROVIDERS binding in the app.
GPU_WORKER_BEARER_TOKEN=
# Local Ollama inside your leased GPU deployment; do not expose unauthenticated Ollama publicly.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:0.6b
# Must agree with onchain advertised concurrent slots; GPU memory limits are operator-reviewed.
GPU_WORKER_SLOTS=1
# Mount persistent storage here; output survives restarts and paid-job retries.
GPU_OUTPUT_DIRECTORY=./.outputs
PORT=8080
